{
  "$comment": "Source of truth for the redesign. Run `bun apps/tools/design-tokens.mjs` to regenerate NoahTokens.swift and NoahTokens.kt.",
  "color": {
    "background": { "light": "#FFFFFF", "dark": "#000000" },
    "foreground": { "light": "#000000", "dark": "#FFFFFF" },
    "muted": { "light": "#707070", "dark": "#8F8F8F" },
    "hairline": { "light": "#0000001F", "dark": "#FFFFFF29" },
    "soft": { "light": "#F2F2F2", "dark": "#1C1C1E" },
    "sheet": { "light": "#FFFFFF", "dark": "#1C1C1E" },
    "orange": { "light": "#F7931A", "dark": "#F7931A" },
    "orangeText": { "light": "#A85800", "dark": "#F7931A" },
    "orangeTint": { "light": "#F7931A26", "dark": "#F7931A26" },
    "failure": { "light": "#D0312D", "dark": "#FF453A" },
    "qrCard": { "light": "#FFFFFF", "dark": "#FFFFFF" },
    "qrInk": { "light": "#0A0A0A", "dark": "#0A0A0A" }
  },
  "font": {
    "display": { "family": "Space Grotesk", "ios": { "medium": "SpaceGrotesk-Medium", "semibold": "SpaceGrotesk-SemiBold" }, "android": { "medium": "space_grotesk_medium", "semibold": "space_grotesk_semibold" } }
  },
  "type": {
    "wordmark": { "size": 80, "weight": "semibold", "font": "display", "tracking": -0.05 },
    "balance": { "size": 50, "weight": "semibold", "font": "display", "tracking": -0.03 },
    "amount": { "size": 36, "weight": "semibold", "font": "display", "tracking": -0.02 },
    "code": { "size": 28, "weight": "semibold", "font": "display", "tracking": 0 },
    "titleLarge": { "size": 40, "lineHeight": 46, "weight": "semibold", "tracking": -0.02 },
    "title": { "size": 30, "lineHeight": 36, "weight": "semibold", "tracking": -0.02 },
    "sheetTitle": { "size": 24, "lineHeight": 30, "weight": "semibold", "tracking": -0.015 },
    "field": { "size": 24, "lineHeight": 32, "weight": "semibold", "tracking": -0.01 },
    "handle": { "size": 34, "lineHeight": 40, "weight": "semibold", "tracking": -0.02 },
    "body": { "size": 17, "lineHeight": 22, "weight": "regular", "tracking": 0 },
    "button": { "size": 17, "lineHeight": 22, "weight": "semibold", "tracking": 0 },
    "label": { "size": 17, "lineHeight": 22, "weight": "medium", "tracking": 0 },
    "control": { "size": 15, "lineHeight": 20, "weight": "medium", "tracking": 0 },
    "sub": { "size": 15, "lineHeight": 20, "weight": "regular", "tracking": 0 },
    "caption": { "size": 13, "lineHeight": 18, "weight": "medium", "tracking": 0.01 }
  },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 20, "screen": 24, "xxl": 32, "xxxl": 40, "huge": 48 },
  "radius": { "s": 10, "m": 16, "l": 24, "card": 30, "sheet": 44, "field": 15 },
  "size": { "button": 56, "buttonCompact": 48, "chip": 36, "hitTarget": 44, "otpBox": 60, "qr": 244 },
  "motion": {
    "$comment": "Springs use SwiftUI's response/dampingFraction. Compose: dampingRatio = damping, stiffness = (2π/response)² with unit mass.",
    "snappy": { "response": 0.30, "damping": 0.85, "use": "screens, sheets, keyboard, digits" },
    "soft": { "response": 0.50, "damping": 1.00, "use": "done ring, ripples, underline, QR reveal" },
    "bouncy": { "response": 0.40, "damping": 0.60, "use": "letters, dots, check, logo" },
    "tap": { "response": 0.12, "damping": 0.80, "use": "key and button press" },
    "reduceMotionFadeMs": 180
  }
}
