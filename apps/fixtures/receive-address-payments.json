    },
    {
      "name": "A payment still pending when Receive appeared arrives once it succeeds",
      "input": {
        "rows": [
          {
            "id": "f",
            "kind": "lightning-receive",
            "status": "successful",
            "direction": "incoming",
            "amount": 1000
          },
          {
            "id": "g",
            "kind": "lightning-receive",
            "status": "successful",
            "direction": "incoming",
            "amount": 1000
          }
        ],
        "settled": [
          "g"
        ],
        "ownArk": [
          "tark1qpayme"
        ],
        "ownHashes": [
          "hash"
        ]
      },
      "expected": {
        "next": "f"
