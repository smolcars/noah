{
  "description": "Payments through your Lightning address that Receive shows arriving (Android ReceiveArrivals.viaAddress / settled, iOS ReceiveAddressPayments). Cases with `expected.next` pick the next arrival from `rows` given `settled`, this screen's own Ark addresses and invoice hashes; cases with `expected.settled` list the receipts already complete when Receive appears. Hand-written.",
  "cases": [
    {
      "name": "A Lightning payment through the address arrives",
      "input": {
        "rows": [
          {
            "id": "a",
            "kind": "lightning-receive",
            "status": "successful",
            "direction": "incoming",
            "amount": 1000,
            "paymentHash": "elsewhere"
          }
        ],
        "settled": [],
        "ownArk": [
          "tark1qpayme"
        ],
        "ownHashes": [
          "hash"
        ]
      },
      "expected": {
        "next": "a"
      }
    },
    {
      "name": "An Ark payment to another of your addresses arrives",
      "input": {
        "rows": [
          {
            "id": "e",
            "kind": "arkoor-receive",
            "status": "successful",
            "direction": "incoming",
            "amount": 1000,
            "receivedOn": [
              "tark1qstatic"
            ]
          }
        ],
        "settled": [],
        "ownArk": [
          "tark1qpayme"
        ],
        "ownHashes": [
          "hash"
        ]
      },
      "expected": {
        "next": "e"
      }
    },
    {
      "name": "A payment to an Ark address the card showed earlier arrives (the server gives Noah users your first one)",
      "input": {
        "rows": [
          {
            "id": "movement-7",
            "kind": "arkoor-receive",
            "status": "successful",
            "direction": "incoming",
            "amount": 1000,
            "receivedOn": [
              "tark1qfirst"
            ]
          }
        ],
        "settled": [],
        "ownArk": [
          "tark1qpayme"
        ],
        "ownHashes": [
          "hash"
        ]
      },
      "expected": {
        "next": "movement-7"
      }
    },
    {
      "name": "A payment to the card's own request, already shown through its completion, doesn't arrive again",
      "input": {
        "rows": [
          {
            "id": "movement-8",
            "kind": "arkoor-receive",
            "status": "successful",
            "direction": "incoming",
            "amount": 1000,
            "receivedOn": [
              "tark1qfirst"
            ]
          }
        ],
        "settled": [
          "movement-8"
        ],
        "ownArk": [
          "tark1qpayme"
        ],
        "ownHashes": [
          "hash"
        ]
      },
      "expected": {
        "next": null
      }
    },
    {
      "name": "A settled receipt never arrives again",
      "input": {
        "rows": [
          {
            "id": "a",
            "kind": "lightning-receive",
            "status": "successful",
            "direction": "incoming",
            "amount": 1000,
            "paymentHash": "elsewhere"
          }
        ],
        "settled": [
          "a"
        ],
        "ownArk": [
          "tark1qpayme"
        ],
        "ownHashes": [
          "hash"
        ]
      },
      "expected": {
        "next": null
      }
    },
    {
      "name": "An Ark payment to this screen's own address is the request's",
