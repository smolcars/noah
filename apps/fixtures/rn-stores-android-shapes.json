          },
          "version": 0
        }
      },
      "expected": {
        "state": {
          "schedules": {},
          "serverSyncPending": true
        },
        "version": 0
      }
    },
    {
      "name": "server-storage",
      "input": {
        "key": "server-storage",
        "envelope": {
          "state": {
            "isRegisteredWithServer": true,
