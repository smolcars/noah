        "version": 0
      }
    },
    {
      "name": "profile-storage",
      "input": {
        "key": "profile-storage",
        "envelope": {
          "state": {
            "displayName": "Upgrade test",
            "preferredCurrency": "EUR",
            "bitcoinAmountUnit": "sats"
          },
          "version": 0
        }
      },
      "expected": {
        "state": {
          "displayName": "Upgrade test",
          "preferredCurrency": "EUR",
          "bitcoinAmountUnit": "sats"
        },
        "version": 0
      }
    },
    {
      "name": "recurring-payment-storage",
      "input": {
        "key": "recurring-payment-storage",
        "envelope": {
          "state": {
            "schedules": {},
