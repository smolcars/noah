    },
    {
      "name": "transaction v0 migration",
      "input": {
        "key": "transaction-storage",
        "envelope": {
          "state": {
            "isAutoBoardingEnabled": false,
            "hasAttemptedAutoBoarding": true,
            "future": {
              "keep": 1
            }
          },
          "version": 0
        }
      },
      "expected": {
        "state": {
          "isAutoBoardingEnabled": false,
          "hasAttemptedAutoBoarding": false
        },
        "version": 1
      }
    }
  ]
}
