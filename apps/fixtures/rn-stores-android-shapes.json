{
  "description": "Real RN Zustand persist bytes; only platform MMKV/logging and unused formatting mocked.",
  "cases": [
    {
      "name": "wallet-storage",
      "input": {
        "key": "wallet-storage",
        "envelope": {
          "state": {
            "isInitialized": true,
            "isWalletLoaded": true,
            "staticVtxoPubkey": null,
            "isBiometricsEnabled": false,
            "isDebugModeEnabled": true,
            "isWalletSuspended": false,
            "hasSeenBatteryOptimizationPrompt": false
          },
          "version": 0
        }
      },
      "expected": {
        "state": {
          "isInitialized": true,
          "isWalletLoaded": true,
          "staticVtxoPubkey": null,
          "isBiometricsEnabled": false,
          "isDebugModeEnabled": true,
          "isWalletSuspended": false,
          "hasSeenBatteryOptimizationPrompt": false
        },
        "version": 0
      }
    },
    {
      "name": "backup-storage",
      "input": {
        "key": "backup-storage",
        "envelope": {
          "state": {
            "backupPending": true,
            "lastBackupAt": null,
            "lastBackupAttemptAt": null,
            "lastBackupStatus": "failed",
            "lastBackupError": "offline",
            "lastBackupId": null,
            "lastUploadedSnapshotSha256": null
          },
          "version": 0
        }
      },
      "expected": {
        "state": {
          "backupPending": true,
          "lastBackupAt": null,
          "lastBackupAttemptAt": null,
          "lastBackupStatus": "failed",
          "lastBackupError": "offline",
          "lastBackupId": null,
          "lastUploadedSnapshotSha256": null
        },
        "version": 0
      }
    },
    {
      "name": "esplora-storage",
      "input": {
        "key": "esplora-storage",
        "envelope": {
          "state": {
            "endpointOverride": "https://example.com/api"
          },
          "version": 0
        }
      },
      "expected": {
        "state": {
          "endpointOverride": "https://example.com/api"
        },
        "version": 0
      }
    },
    {
      "name": "privacy-storage",
      "input": {
        "key": "privacy-storage",
        "envelope": {
          "state": {
            "isHomeBalanceHidden": true
          },
          "version": 0
        }
      },
      "expected": {
