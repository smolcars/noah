{
  "description": "RN deviceInfo.test.js cases plus iOS boundary/null/escaping cases. Millisecond timestamps.",
  "cases": [
    {
      "name": "unchanged recent details",
      "input": {
        "device": {
          "app_build": "27",
          "app_version": "0.1.4",
          "device_manufacturer": "Apple",
          "device_model": "iPhone 12 Pro",
          "os_name": "iOS",
          "os_version": "26.5"
        },
        "fingerprint": "[\"Apple\",\"iPhone 12 Pro\",\"iOS\",\"26.5\",\"0.1.4\",\"27\"]",
        "reportedAt": 1784159999000,
        "now": 1784160000000
      },
      "expected": {
        "fingerprint": "[\"Apple\",\"iPhone 12 Pro\",\"iOS\",\"26.5\",\"0.1.4\",\"27\"]",
        "shouldReport": false
      }
    },
    {
      "name": "app_version changed",
      "input": {
        "device": {
          "app_build": "27",
          "app_version": "0.1.4",
          "device_manufacturer": "Apple",
          "device_model": "iPhone 12 Pro",
          "os_name": "iOS",
          "os_version": "26.5"
        },
        "fingerprint": "[\"Apple\",\"iPhone 12 Pro\",\"iOS\",\"26.5\",\"0.1.3\",\"27\"]",
        "reportedAt": 1784159999000,
        "now": 1784160000000
      },
      "expected": {
        "fingerprint": "[\"Apple\",\"iPhone 12 Pro\",\"iOS\",\"26.5\",\"0.1.4\",\"27\"]",
        "shouldReport": true
      }
    },
    {
      "name": "app_build changed",
      "input": {
        "device": {
          "app_build": "27",
          "app_version": "0.1.4",
