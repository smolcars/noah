      "input": {
        "value": "bitcoin:bcrt1example?amount=0.00001",
        "pasted": false
      },
      "expected": "bitcoin:bcrt1example?amount=0.00001"
    },
    {
      "name": "invoice",
      "input": {
        "value": "lnbcrt1example",
        "pasted": false
      },
      "expected": "lnbcrt1example"
    },
    {
