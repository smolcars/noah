      "input": {
        "value": "invalid request",
        "pasted": false
      },
      "expected": "invalid request"
    },
    {
      "name": "empty scan",
      "input": {
        "value": "",
        "pasted": false
      },
      "expected": null
    },
    {
      "name": "empty paste",
      "input": {
        "value": "  \n",
        "pasted": true
      },
      "expected": null
    },
    {
      "name": "paste preserves input",
      "input": {
        "value": " alice@pay.example.com ",
