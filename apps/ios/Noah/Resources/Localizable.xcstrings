    "About {amount} a VTXO now, from your on-chain bitcoin.": {
      "comment": "GT gt_a520965e40a8e4d5; arguments: amount",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %1$@ a VTXO now, from your on-chain bitcoin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos %1$@ por VTXO ahora, de tus bitcoins en cadena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在VTXOあたり約%1$@、オンチェーンのビットコインから支払います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 VTXO당 약 %1$@이며 온체인 비트코인에서 지불해요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefär %1$@ per VTXO just nu, från dina bitcoin på blockkedjan."
          }
        }
      }
    },
    "Acknowledge the current payment before approving it again.": {
