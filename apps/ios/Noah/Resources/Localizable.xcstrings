          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este VTXO ya no figura entre los VTXOs actuales de la billetera. Actualiza para comprobar su estado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このVTXOは、ウォレット内の現在のVTXO一覧には含まれていません。更新して状況を確認してください。"
