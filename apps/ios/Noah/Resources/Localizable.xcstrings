          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah aún está terminando una copia de seguridad. Inténtalo de nuevo en un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahでバックアップ処理が続いています。少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah에서 백업을 마무리하는 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "sv": {
