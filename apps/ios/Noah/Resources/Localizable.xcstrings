    "Noah is still in beta. There is a possibility you could lose money. Only deposit funds you are willing to lose.": {
      "comment": "GT c12ebc0b8ca3cb19; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah is still in beta. There is a possibility you could lose money. Only deposit funds you are willing to lose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah sigue en fase beta. Podrías perder dinero. Deposita solo fondos que estés dispuesto a perder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahはまだベータ版です。資金を失う可能性があります。失っても差し支えない金額のみ入金してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah는 아직 베타 버전으로, 자금을 잃을 위험이 있습니다. 잃어도 감당할 수 있는 금액만 입금하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah är fortfarande en betaversion. Det finns en risk att du förlorar pengar. Sätt bara in pengar som du är beredd att förlora."
          }
        }
      }
    },
    "Noah progresses exits automatically. You can also progress all pending exits manually.": {
      "comment": "Native-only copy; no RN translation. Intentionally English.",
      "extractionState": "manual",
