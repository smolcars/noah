    "Additional confirmed onchain funds required. Deposit funds and wait for confirmation before progressing.": {
      "comment": "GT 339cf8ff5ed251e6; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional confirmed onchain funds required. Deposit funds and wait for confirmation before progressing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesitan más fondos confirmados en la cadena. Deposita fondos y espera a que se confirmen antes de continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認済みのオンチェーン資金が追加で必要です。入金して承認を待ってから、出金処理を進めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확정된 온체인 자금이 추가로 필요합니다. 자금을 입금하고 확정될 때까지 기다린 후 진행하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det krävs mer bekräftade medel på kedjan. Sätt in medel och vänta på bekräftelse innan du går vidare."
          }
        }
      }
    },
    "Additional confirmed onchain funds required. You are starting tracking anyway; fund the wallet before progressing.": {
      "comment": "GT 34edad1f5f0314d9; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional confirmed onchain funds required. You are starting tracking anyway; fund the wallet before progressing."
