    "Backups are encrypted with your seed phrase and stored securely on our servers. We can never access your funds or data.": {
      "comment": "GT 17f6bf7b8f720e1e; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are encrypted with your seed phrase and stored securely on our servers. We can never access your funds or data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad se cifran con tu frase semilla y se almacenan de forma segura en nuestros servidores. Nunca podremos acceder a tus fondos ni a tus datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップはお客様のシードフレーズで暗号化され、当社のサーバーに安全に保存されます。当社がお客様の資金やデータにアクセスすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업은 사용자의 시드 문구로 암호화되어 저희 서버에 안전하게 저장됩니다. 저희는 사용자의 자금이나 데이터에 절대 접근할 수 없습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säkerhetskopiorna krypteras med din återställningsfras och lagras säkert på våra servrar. Vi kan aldrig komma åt dina tillgångar eller dina data."
          }
        }
      }
    },
