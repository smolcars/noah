    "MAX sends one balance in full. The miner fee is deducted from the final amount.": {
      "comment": "GT 589bfb07b45930b5; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MAX sends one balance in full. The miner fee is deducted from the final amount."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MAX envía la totalidad de uno de los saldos. La comisión de minería se descuenta del importe final."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MAXでは、選んだ残高を全額送金します。マイナー手数料は最終的な金額から差し引かれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MAX를 선택하면 한쪽 잔액을 전액 보냅니다. 채굴 수수료는 최종 금액에서 차감됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MAX skickar hela det valda saldot. Mineravgiften dras från slutbeloppet."
          }
        }
      }
