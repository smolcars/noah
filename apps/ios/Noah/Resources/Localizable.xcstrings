    "Not enough on-chain bitcoin for the fees. The exit starts, then waits until you add about {amount}.": {
      "comment": "GT gt_e843a23b9e84091b; arguments: amount",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough on-chain bitcoin for the fees. The exit starts, then waits until you add about %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficientes bitcoins en cadena para las comisiones. La salida empieza y espera hasta que añadas unos %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手数料に必要なオンチェーンのビットコインが足りません。出金は開始され、約%1$@を追加するまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수수료를 낼 온체인 비트코인이 부족해요. 출금은 시작되고, 약 %1$@을 추가할 때까지 기다려요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inte tillräckligt med bitcoin på blockkedjan för avgifterna. Uttaget startar och väntar sedan tills du lägger till ungefär %1$@."
          }
        }
      }
    },
