    "Ark's published Lightning fees for this amount can reach {fee} sats, above your automatic limit of {cap} sats. Review it to pay manually.": {
      "comment": "GT gt_1a5b92522bb6c9c8; arguments: fee, cap",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ark's published Lightning fees for this amount can reach %1$@ sats, above your automatic limit of %2$@ sats. Review it to pay manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las comisiones de Lightning publicadas por Ark para este importe pueden alcanzar %1$@ sats y superar tu límite automático de %2$@ sats. Revisa el pago para realizarlo manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この金額に対してArkが公表しているライトニング手数料は最大%1$@ satsで、自動支払いの手数料上限である%2$@ satsを超えています。内容を確認して手動で支払ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 금액에 대해 Ark가 공개한 Lightning 수수료는 최대 %1$@ sats로, 자동 결제 수수료 한도인 %2$@ sats를 초과할 수 있습니다. 확인 후 직접 결제하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arks publicerade Lightning-avgifter för det här beloppet kan uppgå till %1$@ sats, vilket överstiger din gräns för automatiska betalningar på %2$@ sats. Granska betalningen för att betala manuellt."
          }
        }
      }
    },
    "Ark's published Lightning fees for this amount can reach {nativeValue1} sats, above your automatic limit of {nativeValue2} sats. Review it to pay manually.": {
      "comment": "GT gt_325d3644954c9188; arguments: nativeValue1, nativeValue2",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ark's published Lightning fees for this amount can reach %1$@ sats, above your automatic limit of %2$@ sats. Review it to pay manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las comisiones Lightning publicadas por Ark para este importe pueden alcanzar los %1$@ sats y superar tu límite automático de %2$@ sats. Revisa el pago para realizarlo manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この金額に対してArkが公表しているライトニング手数料は最大%1$@ satsで、自動支払いの上限%2$@ satsを超えています。内容を確認して手動で支払ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 금액에 대해 Ark가 공개한 Lightning 수수료는 최대 %1$@ sats로, 자동 결제 수수료 한도인 %2$@ sats를 초과할 수 있습니다. 검토 후 수동으로 결제하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arks publicerade Lightning-avgifter för det här beloppet kan uppgå till %1$@ sats, vilket överstiger din gräns för automatiska betalningar på %2$@ sats. Granska betalningen för att betala manuellt."
          }
        }
      }
    },
