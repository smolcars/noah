        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora 엔드포인트에는 쿼리 문자열이나 프래그먼트를 포함할 수 없습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora-slutpunkten får inte innehålla en frågesträng eller ett fragment."
          }
        }
      }
    },
