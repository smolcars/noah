          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンチェーン資金で%1$@ sats、手数料、予備資金5,000 satsをまかなえる場合に、Arkへの入金を提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온체인 자금으로 %1$@ sats, 수수료, 예비 자금 5,000 sats를 충당할 수 있으면 입금 여부를 묻습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
