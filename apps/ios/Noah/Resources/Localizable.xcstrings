          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La programación de activación aún no se ha sincronizado. Noah volverá a intentarlo cuando lo abras."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動スケジュールはまだ同期されていません。Noahを開くと再試行します。"
