          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットのバックアップが正常に完了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 안전하게 백업되었습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plånbok har säkerhetskopierats."
          }
        }
      }
    },
    "Your wallet is currently suspended. All wallet operations are disabled.": {
      "comment": "GT gt_50720c8f08138a5e; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wallet is currently suspended. All wallet operations are disabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu billetera está suspendida. Todas sus operaciones están deshabilitadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットは現在停止中です。すべてのウォレット操作が無効になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 지갑 사용이 중지되어 있습니다. 모든 지갑 기능을 사용할 수 없습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plånbok är för närvarande avstängd. Alla plånboksfunktioner är inaktiverade."
          }
        }
      }
    },
    "Your wallet is ready.": {
