    "Choose a Lightning username. You can optionally link a Nostr public key so the same address also works as a NIP-05 identifier.": {
      "comment": "GT c25df60ffb9fcaeb; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a Lightning username. You can optionally link a Nostr public key so the same address also works as a NIP-05 identifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un nombre de usuario para Lightning. Si quieres, puedes vincular una clave pública de Nostr para que la misma dirección también funcione como identificador NIP-05."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightningのユーザー名を設定してください。Nostrの公開鍵を紐づけることもできます。紐づけると、同じアドレスをNIP-05識別子としても使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightning 사용자 이름을 정하세요. 원하면 Nostr 공개 키를 연결해 같은 주소를 NIP-05 식별자로도 사용할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett Lightning-användarnamn. Om du vill kan du koppla en offentlig Nostr-nyckel till adressen så att den även fungerar som en NIP-05-identifierare."
          }
        }
      }
    },
