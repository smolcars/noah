    "Boarding submitted but unconfirmed. Noah will keep trying the broadcast. Do not board these funds again.": {
      "comment": "GT gt_aca0fb7b6af91d5e; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boarding submitted but unconfirmed. Noah will keep trying the broadcast. Do not board these funds again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Depósito enviado, pero sin confirmar. Noah seguirá intentando difundirlo. No vuelvas a depositar estos fondos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkへの入金を送信しましたが、まだ確認されていません。Noahはブロードキャストを引き続き試みます。この資金を再びArkに入金しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입금이 제출되었지만 확정되지 않았습니다. Noah가 계속 전파를 시도합니다. 이 자금을 다시 입금하지 마세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Insättningen har skickats men är inte bekräftad. Noah fortsätter att försöka sända den. Sätt inte in dessa medel igen."
          }
        }
      }
    },
    "Boarding submitted, but delivery is unconfirmed. Noah will keep retrying the broadcast. Do not board again.": {
      "comment": "GT gt_21bea5494ecbdd9d; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boarding submitted, but delivery is unconfirmed. Noah will keep retrying the broadcast. Do not board again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Depósito enviado, pero su recepción no está confirmada. Noah seguirá intentando difundirlo. No vuelvas a depositar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkへの入金リクエストを送信しましたが、到達は確認できていません。Noahはブロードキャストを再試行し続けます。再度Arkに入金しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입금이 제출되었지만 전달 여부는 확인되지 않았습니다. Noah가 계속 전파를 재시도합니다. 다시 입금하지 마세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Insättning skickad, men det är inte bekräftat att den har nått fram. Noah fortsätter att försöka sända transaktionen. Gör ingen ny insättning."
          }
        }
      }
    },
    "Boarding submitted. Funds become spendable after the board completes.": {
      "comment": "GT gt_01c437c9f900b81f; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boarding submitted. Funds become spendable after the board completes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Depósito enviado. Los fondos podrán gastarse cuando se complete el depósito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkへの入金リクエストを送信しました。入金が完了すると資金を使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입금 요청이 제출되었습니다. 입금이 완료되면 자금을 사용할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Insättning skickad. Medlen kan användas när insättningen är klar."
          }
        }
      }
    },
    "Boarding was not submitted. Review again when the wallet is ready.": {
      "comment": "GT gt_8fed00ef8e09c48a; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boarding was not submitted. Review again when the wallet is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envió el depósito. Revísalo de nuevo cuando la billetera esté lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkへの入金は送信されませんでした。ウォレットの準備ができたら再度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입금이 제출되지 않았습니다. 지갑이 준비되면 다시 검토하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Insättningen skickades inte. Granska igen när plånboken är redo."
          }
        }
      }
    },
