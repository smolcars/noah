    "Unable to check this payment. Sending remains stopped.": {
      "comment": "GT gt_ed8e5311ed8b968a; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to check this payment. Sending remains stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede comprobar este pago. Los envíos siguen detenidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この支払いを確認できません。送金は引き続き停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결제를 확인할 수 없습니다. 전송 중지 상태가 유지됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte kontrollera den här betalningen. Det går fortfarande inte att skicka betalningar."
          }
        }
      }
    },
    "Unable to inspect this payment. It may already be in progress. Check status before sending again.": {
      "comment": "GT gt_107e6e5754590692; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to inspect this payment. It may already be in progress. Check status before sending again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede comprobar este pago. Es posible que ya esté en curso. Comprueba su estado antes de enviarlo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この支払いを確認できません。すでに処理中の可能性があります。再送信する前に状況を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결제를 확인할 수 없습니다. 이미 진행 중일 수 있습니다. 다시 보내기 전에 상태를 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att kontrollera den här betalningen. Den kan redan pågå. Kontrollera status innan du skickar igen."
          }
        }
      }
    },
    "Unable to load saved payment status. Check your history and recipient before forgetting this attempt.": {
      "comment": "GT gt_f9ce4ec1f84197b7; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to load saved payment status. Check your history and recipient before forgetting this attempt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el estado guardado del pago. Revisa tu historial y el destinatario antes de descartar este intento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された支払い状況を読み込めません。この支払いの試行記録を削除する前に、履歴と受取人を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 결제 상태를 불러올 수 없습니다. 이 시도 기록을 삭제하기 전에 내역과 받는 사람을 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att läsa in sparad betalningsstatus. Kontrollera historiken och mottagaren innan du tar bort det här försöket."
          }
        }
      }
    },
