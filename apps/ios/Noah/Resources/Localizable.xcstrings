        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのラウンドからの%1$@件の出金: トランザクションは%3$@件ではなく%2$@件。共有分の送信と支払いは1回だけです。"
          }
        },
        "ko": {
