    "You can still browse the full map. Enable location in Settings to see nearby places.": {
      "comment": "GT gt_c863d86963f48c57; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still browse the full map. Enable location in Settings to see nearby places."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir explorando todo el mapa. Activa la ubicación en los ajustes para ver lugares cercanos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図全体は引き続き閲覧できます。近くの場所を表示するには、設定で位置情報を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 지도는 계속 볼 수 있습니다. 주변 장소를 보려면 설정에서 위치 기능을 켜세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortfarande utforska hela kartan. Aktivera platsåtkomst i Inställningar för att se platser i närheten."
          }
        }
      }
    },
    "You can still browse the full map. To see nearby places, allow location in Android Settings.": {
      "comment": "GT gt_b5f752b74adc1621; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still browse the full map. To see nearby places, allow location in Android Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir explorando todo el mapa. Para ver lugares cercanos, permite el acceso a la ubicación en los ajustes de Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図全体は引き続き閲覧できます。近くの場所を表示するには、Androidの設定で位置情報へのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 지도는 계속 볼 수 있습니다. 주변 장소를 보려면 Android 설정에서 위치 접근을 허용하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortfarande utforska hela kartan. Tillåt platsåtkomst i Android-inställningarna för att se platser i närheten."
          }
        }
      }
    },
    "You could pay twice": {
