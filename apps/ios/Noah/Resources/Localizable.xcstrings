        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen säkerhetskopia hittades för den här återställningsfrasen. Kontrollera orden och att säkerhetskopiering var aktiverad för plånboken."
          }
        }
      }
