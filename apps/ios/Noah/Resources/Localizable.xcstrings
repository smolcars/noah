    "Regular fee rate: {rate} sat/vB. Estimated as a {size} vB 2-in/2-out SegWit transaction.": {
      "comment": "GT 58299fc13b48cdcf; arguments: rate, size",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular fee rate: %1$@ sat/vB. Estimated as a %2$@ vB 2-in/2-out SegWit transaction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasa de comisión normal: %1$@ sat/vB. Estimada para una transacción SegWit de %2$@ vB con 2 entradas y 2 salidas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の手数料率：%1$@ sat/vB。入力2件・出力2件の%2$@ vBのSegWit取引として見積もっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 수수료율: %1$@ sat/vB. 입력 2개와 출력 2개가 있는 %2$@ vB 크기의 SegWit 거래를 기준으로 추정했습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal avgiftssats: %1$@ sat/vB. Uppskattningen baseras på en SegWit-transaktion på %2$@ vB med 2 indata och 2 utdata."
          }
        }
      }
    },
