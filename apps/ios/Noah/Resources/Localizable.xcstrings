    "Noah progresses exits automatically. You can also progress all pending exits manually.": {
      "comment": "GT gt_f9e22cf4260bab0d; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah progresses exits automatically. You can also progress all pending exits manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah hace avanzar las salidas automáticamente. También puedes hacer avanzar manualmente todas las salidas pendientes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahは退出に伴う出金処理を自動で進めます。保留中の退出すべてについて、手動で出金処理を進めることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah는 출금을 자동으로 진행합니다. 대기 중인 모든 출금을 수동으로 진행할 수도 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah går automatiskt vidare med nöduttag. Du kan också gå vidare med alla väntande nöduttag manuellt."
          }
        }
      }
    },
    "Noah sends this payment automatically from your Ark balance. Only this recipient and amount are ever allowed, and you can pause or cancel at any time.": {
      "comment": "GT gt_286c0deecb39be99; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah sends this payment automatically from your Ark balance. Only this recipient and amount are ever allowed, and you can pause or cancel at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah realiza este pago automáticamente con tu saldo de Ark. Solo se autorizan pagos a este destinatario por este importe, y puedes pausarlos o cancelarlos en cualquier momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NoahがArk残高からこの支払いを自動で行います。支払いは指定された受取人と金額に限られ、いつでも一時停止やキャンセルができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 Ark 잔액에서 자동으로 결제합니다. 지정된 받는 사람에게 정해진 금액만 결제되며, 언제든지 일시 중지하거나 취소할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah skickar den här betalningen automatiskt från ditt Ark-saldo. Betalningen får bara skickas till den här mottagaren och med det här beloppet. Du kan pausa eller avsluta den när som helst."
          }
        }
      }
    },
