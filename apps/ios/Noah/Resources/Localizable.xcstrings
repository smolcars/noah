            "value": "You already have an exit in progress. Start another one only for remaining VTXOs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes una salida en curso. Inicia otra solo para los VTXOs restantes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに進行中の出金があります。新たな出金は、残りのVTXOのみを対象に開始してください。"
