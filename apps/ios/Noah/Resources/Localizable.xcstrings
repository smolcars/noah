    "Recurring payment data couldn't be read. Your saved schedules have been preserved. Sending is stopped.": {
      "comment": "GT gt_e96cc9747bde094a; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurring payment data couldn't be read. Your saved schedules have been preserved. Sending is stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los datos de pagos recurrentes. Se han conservado tus programaciones guardadas. Los envíos están detenidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期支払いデータを読み取れませんでした。保存済みのスケジュールは保持されています。送金は停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기 결제 데이터를 읽지 못했습니다. 저장된 결제 예약은 그대로 보존되었습니다. 전송이 중지되었습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Data för återkommande betalningar kunde inte läsas. Dina sparade scheman har bevarats. Det går inte att skicka betalningar."
          }
        }
      }
    },
    "Recurring payment history needs attention. Its saved evidence has been preserved; sending remains stopped.": {
      "comment": "GT gt_7bca5b89bad58cde; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurring payment history needs attention. Its saved evidence has been preserved; sending remains stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de pagos recurrentes requiere atención. Se han conservado los registros guardados; el envío sigue detenido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期支払いの履歴を確認する必要があります。保存済みの記録は保持されています。送信は停止したままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기 결제 기록을 확인해야 합니다. 저장된 증빙 자료는 보존되어 있으며, 전송은 계속 중지된 상태입니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Historiken för återkommande betalningar behöver ses över. Det sparade underlaget har bevarats. Inga betalningar skickas tills vidare."
          }
        }
      }
    },
