    "Submitted, awaiting broadcast. Noah will keep retrying the broadcast. Do not send this payment again.": {
      "comment": "GT gt_b50137cc6d52c59c; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitted, awaiting broadcast. Noah will keep retrying the broadcast. Do not send this payment again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciado, pendiente de difusión. Noah seguirá intentando difundirlo. No vuelvas a enviar este pago."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受付済みで、ブロードキャスト待ちです。Noahはブロードキャストを引き続き試みます。この支払いを再送信しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출되었으며 전파를 기다리고 있습니다. Noah가 계속 전파를 재시도합니다. 이 결제를 다시 보내지 마세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inskickad, väntar på sändning. Noah fortsätter att försöka sända den. Skicka inte den här betalningen igen."
          }
        }
      }
    },
