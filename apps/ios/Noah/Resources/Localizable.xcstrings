        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío recurrente está detenido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期送金は停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기 전송이 중지되었습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återkommande betalningar har stoppats."
          }
        }
      }
    },
    "Recurring wallet identity couldn't be read. Sending is stopped.": {
      "comment": "GT gt_84667ee20bc5ea45; arguments: none",
