    "Repeat protection overridden. The original attempt is still saved. Review the current wallet state before submitting again.": {
      "comment": "GT gt_dc11f56227629a10; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat protection overridden. The original attempt is still saved. Review the current wallet state before submitting again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protección contra repeticiones anulada. El intento original sigue guardado. Revisa el estado actual de la billetera antes de volver a enviar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複防止が解除されました。元の試行の記録は引き続き保存されています。再送信する前に、現在のウォレットの状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복 방지가 해제되었습니다. 기존 시도 기록은 그대로 저장되어 있습니다. 다시 제출하기 전에 현재 지갑 상태를 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyddet mot upprepning har åsidosatts. Det ursprungliga försöket är fortfarande sparat. Granska plånbokens aktuella tillstånd innan du skickar igen."
          }
        }
      }
    },
