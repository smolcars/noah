    "Left out: {amount} that costs more in fees than it’s worth. Choose it to exit anyway.": {
      "comment": "GT gt_4f14b3e9b20d43a4; arguments: amount",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left out: %1$@ that costs more in fees than it’s worth. Choose it to exit anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluidos: %1$@ que cuestan más en comisiones de lo que valen. Elígelos para sacarlos igualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "除外: 価値より手数料が高い%1$@。それでも出金するには個別に選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제외: 가치보다 수수료가 더 드는 %1$@. 그래도 출금하려면 직접 선택하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utelämnat: %1$@ som kostar mer i avgifter än det är värt. Välj det för att ta ut det ändå."
          }
        }
      }
    },
