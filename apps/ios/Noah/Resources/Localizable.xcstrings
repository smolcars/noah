    "This removes your wallet and recovery phrase from this device. Make sure you have saved your recovery phrase. Type delete to confirm.": {
      "comment": "GT gt_e3475188c78e15ad; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes your wallet and recovery phrase from this device. Make sure you have saved your recovery phrase. Type delete to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu billetera y tu frase de recuperación de este dispositivo. Asegúrate de haber guardado tu frase de recuperación. Escribe delete para confirmar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末からウォレットと復元フレーズを削除します。復元フレーズを保存してあることを確認してください。確認のため delete と入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 지갑과 복구 문구가 삭제됩니다. 복구 문구를 별도로 저장했는지 확인하세요. 계속하려면 delete를 입력하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar bort din plånbok och återställningsfras från den här enheten. Se till att du har sparat din återställningsfras. Skriv delete för att bekräfta."
          }
        }
      }
    },
