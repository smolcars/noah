    "MAX requires an on-chain address without a fixed amount.": {
      "comment": "GT gt_0cf896b378674f75; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MAX requires an on-chain address without a fixed amount."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MAX requiere una dirección en cadena sin un importe fijo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MAXを使うには、金額が指定されていないオンチェーンアドレスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MAX를 사용하려면 금액이 지정되지 않은 온체인 주소가 필요합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MAX kräver en on-chain-adress utan fast belopp."
          }
        }
      }
    },
    "MAX uses confirmed funds only and deducts the onchain fee from that balance.": {
      "comment": "GT gt_6f3359083a6fca2d; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MAX uses confirmed funds only and deducts the onchain fee from that balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MÁX. usa solo fondos confirmados y descuenta de ese saldo la comisión en cadena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最大」は承認済みの資金のみを使い、その残高からオンチェーン手数料を差し引きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대는 확정된 자금만 사용하며 그 잔액에서 온체인 수수료를 차감해요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MAX använder bara bekräftade medel och drar avgiften på blockkedjan från det saldot."
          }
        }
      }
    },
