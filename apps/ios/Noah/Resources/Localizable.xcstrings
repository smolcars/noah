    "Your wallet is suspended. Resume it to view transactions.": {
      "comment": "GT gt_a672c47ec618d7b7; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wallet is suspended. Resume it to view transactions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu billetera está suspendida. Reanúdala para ver las transacciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットは一時停止中です。取引を表示するには再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 일시 중지되었습니다. 거래를 보려면 지갑을 재개하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plånbok är pausad. Återuppta den för att visa transaktioner."
          }
        }
      }
    },
    "Your wallet is suspended. Resume recovery to restore its backup, or delete this wallet from your device.": {
      "comment": "GT gt_b4a8692900c62adf; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wallet is suspended. Resume recovery to restore its backup, or delete this wallet from your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu billetera está suspendida. Reanuda la recuperación para restaurar su copia de seguridad o elimina esta billetera de tu dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットは停止中です。復旧を再開してバックアップを復元するか、このウォレットを端末から削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 일시 중지되었습니다. 복구를 재개하여 백업을 복원하거나 기기에서 이 지갑을 삭제하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plånbok är tillfälligt inaktiverad. Återuppta återställningen för att återställa säkerhetskopian, eller radera den här plånboken från enheten."
          }
        }
      }
    },
