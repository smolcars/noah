          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no pudo eliminar los archivos temporales de la billetera. Reinicia Noah e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットの一時ファイルを削除できませんでした。Noahを再起動して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 임시 지갑 파일을 삭제하지 못했습니다. Noah를 다시 시작한 후 다시 시도하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kunde inte ta bort tillfälliga plånboksfiler. Starta om Noah och försök igen."
          }
        }
      }
    },
    "Noah couldn't restore your wallet. Please try again later.": {
      "comment": "GT gt_62ee841196b41940; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
