    },
    "Allow Noah to monitor your Ark mailbox so it can wake this app to claim Lightning payments in the background.": {
      "comment": "GT gt_d08c48b7696a251e; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Noah to monitor your Ark mailbox so it can wake this app to claim Lightning payments in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Noah supervise tu buzón de Ark para que pueda activar esta aplicación y recibir pagos de Lightning en segundo plano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NoahがArkメールボックスを監視し、バックグラウンドでライトニングの支払いを受け取るためにこのアプリを起動することを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 Ark 우편함을 모니터링하도록 허용하세요. Lightning 결제를 받을 때 앱을 백그라운드에서 실행해 수령할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt Noah bevaka din Ark-brevlåda så att appen kan väckas för att ta emot Lightning-betalningar i bakgrunden."
          }
        }
      }
    },
    "Allow Noah to receive payment notifications and maintain your wallet while it is in the background.": {
      "comment": "GT gt_0b5a096e5fb17b77; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Noah to receive payment notifications and maintain your wallet while it is in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Noah reciba notificaciones de pago y mantenga tu billetera en segundo plano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahがバックグラウンドで支払い通知を受信し、ウォレットを管理できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 백그라운드에서 결제 알림을 받고 지갑을 관리할 수 있도록 허용하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Noah att ta emot betalningsaviseringar och underhålla din plånbok i bakgrunden."
          }
        }
      }
    },
    "Allow Noah to wake the app to claim incoming payments": {
      "comment": "GT gt_39c457807f3a1784; arguments: none",
      "extractionState": "manual",
      "localizations": {
