      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to reserve the wallet. Check payment status before sending again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reservar la billetera. Comprueba el estado del pago antes de volver a enviarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットを確保できません。再送信する前に支払い状況を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑을 예약할 수 없습니다. 다시 보내기 전에 결제 상태를 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att reservera plånboken. Kontrollera betalningens status innan du skickar igen."
          }
        }
      }
    },
    "Unable to resolve this recipient. Please check the address.": {
