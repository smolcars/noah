    "Automatic payment to {recipient} was skipped. Open the schedule to review its fee and pay manually.": {
      "comment": "GT gt_168ae9aa2da9e959; arguments: recipient",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic payment to %1$@ was skipped. Open the schedule to review its fee and pay manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitió el pago automático a %1$@. Abre la programación para revisar la comisión y pagar manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@への自動支払いはスキップされました。スケジュールを開いて手数料を確認し、手動で支払ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@님에게 보낼 자동 결제를 건너뛰었습니다. 일정을 열어 수수료를 확인하고 직접 결제하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den automatiska betalningen till %1$@ hoppades över. Öppna schemat för att granska avgiften och betala manuellt."
          }
        }
      }
    },
    "Automatic payments from your Ark balance": {
      "comment": "GT gt_15ad603144760542; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
