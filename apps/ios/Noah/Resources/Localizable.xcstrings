    "Without them, Noah can’t receive payments or renew your bitcoin before it expires.": {
      "comment": "GT gt_9c91b3b673435dea; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without them, Noah can’t receive payments or renew your bitcoin before it expires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ellas, Noah no puede recibir pagos ni renovar tu bitcoin antes de que caduque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がないと、Noah は支払いを受け取れず、ビットコインが期限切れになる前に更新することもできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 없으면 Noah는 결제를 받거나 비트코인이 만료되기 전에 갱신할 수 없습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan dem kan Noah inte ta emot betalningar eller förnya din bitcoin innan den löper ut."
          }
        }
      }
    },
