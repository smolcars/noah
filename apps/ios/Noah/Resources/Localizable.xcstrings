          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles en tiempo real no están disponibles. Los lugares incluidos siguen disponibles sin conexión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の詳細情報を取得できません。アプリに含まれる場所情報は引き続きオフラインで利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 상세 정보를 불러올 수 없습니다. 기본 제공되는 장소 정보는 오프라인에서도 이용할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuell information är inte tillgänglig. De medföljande platserna fungerar fortfarande offline."
