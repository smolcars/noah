    "Lightning invoices can only be paid once. Use a Lightning address or offer": {
      "comment": "GT gt_31312f51a5df40b4; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightning invoices can only be paid once. Use a Lightning address or offer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las facturas de Lightning solo se pueden pagar una vez. Usa una dirección o una oferta de Lightning"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトニング請求書は一度しか支払えません。ライトニングアドレスまたはオファーを使用してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이트닝 인보이스는 한 번만 결제할 수 있습니다. 라이트닝 주소나 라이트닝 오퍼를 사용하세요"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightning-fakturor kan bara betalas en gång. Använd en Lightning-adress eller ett Lightning-erbjudande"
          }
        }
      }
    },
    "Lightning is still finding a route. You can leave this screen; Noah finishes it in the background.": {
