    "Move available onchain funds into Ark while leaving a fee reserve in your onchain wallet.": {
      "comment": "GT 7f96fe16dfd233d5; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move available onchain funds into Ark while leaving a fee reserve in your onchain wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfiere a Ark los fondos disponibles en cadena y deja una reserva para comisiones en tu billetera en cadena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンチェーンウォレットに手数料用の資金を残し、利用可能なオンチェーン資金をArkに移します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온체인 지갑에 수수료로 쓸 금액을 남겨 두고, 사용 가능한 온체인 자금을 Ark로 옮깁니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta tillgängliga medel på kedjan till Ark och lämna kvar en reserv för avgifter i din plånbok på kedjan."
          }
        }
      }
    },
    "Move onchain bitcoin into Ark for fast, low-cost payments.": {
