        }
      }
    },
    "Noah couldn't safely undo the restore. Do not retry. Close and restart Noah so it can recover your wallet.": {
      "comment": "GT gt_db92e3e2f6075f8b; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah couldn't safely undo the restore. Do not retry. Close and restart Noah so it can recover your wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no pudo deshacer la restauración de forma segura. No lo intentes de nuevo. Cierra y reinicia Noah para que pueda recuperar tu billetera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahは復元を安全に取り消せませんでした。再試行しないでください。ウォレットを復旧できるよう、Noahを閉じて再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 복원을 안전하게 되돌리지 못했습니다. 다시 시도하지 마세요. 지갑을 복구할 수 있도록 Noah를 종료한 후 다시 시작하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kunde inte ångra återställningen på ett säkert sätt. Försök inte igen. Stäng och starta om Noah så att plånboken kan återställas."
          }
        }
      }
    },
    "Noah default": {
