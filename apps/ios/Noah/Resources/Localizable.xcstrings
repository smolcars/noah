    "A payment to {recipient} was interrupted. Check your history, then resume it.": {
      "comment": "GT gt_f6a7e36fc225654b; arguments: recipient",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A payment to %1$@ was interrupted. Check your history, then resume it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interrumpió un pago a %1$@. Revisa tu historial y luego reanuda el pago."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@への支払いが中断されました。履歴を確認してから再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에게 보내던 결제가 중단되었습니다. 내역을 확인한 후 재개하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En betalning till %1$@ avbröts. Kontrollera historiken och återuppta sedan betalningen."
          }
        }
      }
    },
    "A reminder comes the day before. A missed payment is skipped, never paid twice.": {
      "comment": "GT gt_36d7ac7edaf6eeeb; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder comes the day before. A missed payment is skipped, never paid twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás un recordatorio el día anterior. Un pago perdido se omite, nunca se paga dos veces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前日にお知らせします。逃した支払いはスキップされ、二重に支払われることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 전에 알림을 보내드립니다. 놓친 결제는 건너뛰며 두 번 결제되지 않습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får en påminnelse dagen innan. En missad betalning hoppas över och betalas aldrig två gånger."
          }
        }
      }
    },
