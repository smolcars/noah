    "The transaction could not be built. No payment was submitted. Review the amount and fee.": {
      "comment": "GT gt_c6e0499eb3d93af4; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction could not be built. No payment was submitted. Review the amount and fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la transacción. No se envió ningún pago. Revisa el importe y la comisión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引を作成できませんでした。支払いは送信されていません。金額と手数料を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래를 생성하지 못했습니다. 결제는 제출되지 않았습니다. 금액과 수수료를 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen kunde inte skapas. Ingen betalning skickades. Granska beloppet och avgiften."
          }
        }
      }
    },
    "The transaction could not be constructed. Nothing was broadcast. Review again.": {
      "comment": "GT gt_3fb33246ab2afa02; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction could not be constructed. Nothing was broadcast. Review again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la transacción. No se difundió nada. Vuelve a revisarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションを作成できませんでした。何もブロードキャストされていません。内容をもう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래를 구성하지 못했습니다. 아무것도 전파되지 않았습니다. 다시 검토해 주세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen kunde inte skapas. Inget sändes. Granska igen."
          }
        }
      }
    },
    "The transactions already on-chain stay there. Your VTXO stays in your wallet and can exit again.": {
      "comment": "GT gt_c6dfefbf1de6c02f; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transactions already on-chain stay there. Your VTXO stays in your wallet and can exit again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transacciones que ya están en cadena se quedan ahí. Tu VTXO sigue en tu billetera y puede salir de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにオンチェーンにあるトランザクションはそのまま残ります。VTXOはウォレットに残り、再び出金できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 온체인에 있는 트랜잭션은 그대로 남아요. VTXO는 지갑에 남아 있고 다시 출금할 수 있어요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionerna som redan finns på blockkedjan blir kvar där. Din VTXO stannar i din plånbok och kan tas ut igen."
          }
        }
      }
    },
    "The wallet or fees changed, or the quote expired. Review again before confirming.": {
      "comment": "GT gt_fd04d8103140aa83; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallet or fees changed, or the quote expired. Review again before confirming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La billetera o las comisiones han cambiado, o la cotización ha caducado. Revisa los datos de nuevo antes de confirmar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットや手数料が変更されたか、見積もりの有効期限が切れました。確定する前に、もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑 상태나 수수료가 변경되었거나 견적이 만료되었습니다. 확정하기 전에 다시 검토하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plånboken eller avgifterna har ändrats, eller så har prisuppgiften upphört att gälla. Granska uppgifterna igen innan du bekräftar."
          }
        }
      }
    },
    "The words that restore your wallet.": {
      "comment": "GT gt_be11c0d9d86f778e; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The words that restore your wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras que restauran tu billetera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットを復元するための単語です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑을 복원하는 단어예요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Orden som återställer din plånbok."
          }
        }
      }
    },
    "Their receipt unlocks it": {
      "comment": "GT gt_d05e4b12e63fdf63; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their receipt unlocks it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su recibo lo desbloquea"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の受領証明でロック解除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대의 영수증으로 잠금 해제"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Deras kvitto låser upp den"
          }
        }
      }
    },
    "Then a wait of about a day before you can claim.": {
      "comment": "GT gt_cd0b2d8136476cb0; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then a wait of about a day before you can claim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego una espera de un día para poder reclamar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後、受け取れるまで約1日待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그다음 청구하기까지 하루쯤 기다려요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedan en väntan på ungefär en dag innan du kan lösa in."
          }
        }
      }
    },
    "Then a {n}-block wait before you can claim.": {
      "comment": "GT gt_a8788032dbf14dad; arguments: n",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then a %1$@-block wait before you can claim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego una espera de %1$@ bloques para poder reclamar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後、受け取れるまで%1$@ブロック待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그다음 청구하기까지 %1$@블록을 기다려요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedan en väntan på %1$@ block innan du kan lösa in."
          }
        }
      }
    },
    "There are not enough confirmed onchain funds for this amount and its fees. Reduce the amount or wait for confirmation.": {
      "comment": "GT gt_9cc11d41c56f8fed; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are not enough confirmed onchain funds for this amount and its fees. Reduce the amount or wait for confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficientes fondos confirmados en cadena para cubrir este importe y sus comisiones. Reduce el importe o espera a que se confirmen los fondos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この金額と手数料を賄うだけの確認済みのオンチェーン資金がありません。金額を減らすか、確認をお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 금액과 수수료를 충당할 확정된 온체인 자금이 부족합니다. 금액을 줄이거나 확정을 기다리세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inte tillräckligt med bekräftade medel på blockkedjan för beloppet och avgifterna. Minska beloppet eller vänta på bekräftelse."
          }
        }
      }
    },
    "There are too many small coins for this board. Try a smaller amount.": {
      "comment": "GT gt_2f536a74d5111f93; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are too many small coins for this board. Try a smaller amount."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiadas monedas de poco valor para este depósito. Prueba con un importe menor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回のArkへの入金には少額のコインが多すぎます。金額を減らしてお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 입금에 사용되는 소액 코인이 너무 많습니다. 더 적은 금액으로 시도해 주세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns för många små mynt för den här insättningen. Försök med ett mindre belopp."
          }
        }
      }
    },
    "These coins are unavailable or reserved by another payment in review. Close that review, then try again.": {
      "comment": "GT gt_e05786d8bf8e865c; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These coins are unavailable or reserved by another payment in review. Close that review, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas monedas no están disponibles o están reservadas para otro pago en revisión. Cierra esa revisión e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのコインは利用できないか、確認中の別の支払いで確保されています。その確認画面を閉じてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코인은 사용할 수 없거나 검토 중인 다른 결제에 사용하도록 예약되어 있습니다. 해당 결제의 검토 화면을 닫고 다시 시도하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här medlen är inte tillgängliga eller är reserverade för en annan betalning som granskas. Stäng den granskningen och försök sedan igen."
          }
        }
      }
    },
    "These recurring payments belong to a previous wallet. They are preserved but cannot run. Cancel them and create new schedules for this wallet.": {
      "comment": "GT gt_7689ea8bed273cfe; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These recurring payments belong to a previous wallet. They are preserved but cannot run. Cancel them and create new schedules for this wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos pagos recurrentes pertenecen a una billetera anterior. Se conservan, pero no pueden ejecutarse. Cancélalos y programa nuevos pagos para esta billetera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの定期支払いは以前のウォレットのものです。保存されていますが、実行できません。これらをキャンセルし、このウォレット用に新しい支払いスケジュールを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 정기 결제들은 이전 지갑에 속합니다. 내역은 보존되어 있지만 실행할 수는 없습니다. 해당 결제를 취소하고 이 지갑에서 새 일정을 만드세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här återkommande betalningarna tillhör en tidigare plånbok. De är sparade men kan inte genomföras. Avbryt dem och skapa nya scheman för den här plånboken."
          }
        }
      }
    },
    "These words don’t form a valid phrase.": {
      "comment": "GT gt_2f1c3676c41f927f; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These words don’t form a valid phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palabras no forman una frase válida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの単語は有効なフレーズになりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어들은 올바른 문구가 아닙니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Orden bildar ingen giltig fras."
          }
        }
      }
    },
    "This Lightning invoice has expired. Request a new invoice.": {
      "comment": "GT gt_23333df084dfad80; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Lightning invoice has expired. Request a new invoice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta factura Lightning ha caducado. Pide una nueva solicitud de pago."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライトニング請求書は期限切れです。新しい請求書をリクエストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이트닝 인보이스는 만료되었습니다. 새 결제 요청서를 요청해 주세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Lightning-fakturan har gått ut. Begär en ny betalningsbegäran."
          }
        }
      }
    },
    "This QR contains only your Lightning address.": {
      "comment": "GT gt_74bb47afc8d3b8c4; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR contains only your Lightning address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código QR contiene solo tu dirección Lightning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このQRコードに含まれるのは、ご自身のライトニングアドレスのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 QR 코드에는 라이트닝 주소만 포함되어 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här QR-koden innehåller bara din Lightning-adress."
          }
        }
      }
    },
    "This VTXO can't be exited.": {
      "comment": "GT gt_064ce079abb02910; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This VTXO can't be exited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede sacar este VTXO."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このVTXOは出金できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 VTXO는 출금할 수 없어요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här VTXO:n kan inte tas ut."
          }
        }
      }
    },
    "This VTXO is no longer in the wallet's current VTXOs. Refresh to check its status.": {
      "comment": "GT gt_1d4b5ac7d8751913; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This VTXO is no longer in the wallet's current VTXOs. Refresh to check its status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este VTXO ya no figura entre los VTXOs actuales de la billetera. Actualiza para comprobar su estado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このVTXOは、ウォレット内の現在のVTXO一覧には含まれていません。更新して状況を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 VTXO는 더 이상 지갑의 현재 VTXO 목록에 없습니다. 새로고침하여 상태를 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här VTXO:n finns inte längre bland plånbokens aktuella VTXO:er. Uppdatera för att kontrollera dess status."
          }
        }
      }
    },
    "This VTXO was already spent, so it can’t exit.": {
      "comment": "GT gt_4cbed14dc727aedc; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This VTXO was already spent, so it can’t exit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este VTXO ya se gastó, así que no puede salir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このVTXOはすでに使用されているため、出金できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 VTXO는 이미 사용되어 출금할 수 없어요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här VTXO:n har redan spenderats, så den kan inte tas ut."
          }
        }
      }
    },
    "This address isn't in your Noah wallet. The claimed funds will be sent there.": {
      "comment": "GT gt_69d8d757288ce17b; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address isn't in your Noah wallet. The claimed funds will be sent there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección no pertenece a tu billetera Noah. Los fondos reclamados se enviarán allí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスは、お使いのNoahウォレットのアドレスではありません。受け取る資金はこのアドレスに送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소는 내 Noah 지갑에 속하지 않습니다. 수령할 자금은 이 주소로 전송됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här adressen tillhör inte din Noah-plånbok. De inlösta medlen skickas dit."
          }
        }
      }
    },
    "This amount exceeds 21 million BTC. Cancel this schedule and approve a new payment within the limit.": {
      "comment": "GT gt_e736f5c6032cba7b; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This amount exceeds 21 million BTC. Cancel this schedule and approve a new payment within the limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este importe supera los 21 millones de BTC. Cancela esta programación y aprueba un nuevo pago dentro del límite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この金額は2,100万BTCを超えています。このスケジュールを取り消して、上限内の新しい支払いを承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 금액은 2,100만 BTC를 초과합니다. 이 결제 예약을 취소하고 한도 이내의 금액으로 새 결제를 승인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här beloppet överstiger 21 miljoner BTC. Avbryt schemat och godkänn en ny betalning inom gränsen."
          }
        }
      }
    },
    "This backup belongs to a different Bitcoin network. Use the matching version of Noah.": {
      "comment": "GT gt_14eec81c84b44811; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup belongs to a different Bitcoin network. Use the matching version of Noah."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad pertenece a una red de Bitcoin diferente. Usa la versión correspondiente de Noah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは別のBitcoinネットワークのものです。対応するバージョンのNoahを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 다른 Bitcoin 네트워크용입니다. 해당 네트워크에 맞는 Noah 버전을 사용하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här säkerhetskopian tillhör ett annat Bitcoin-nätverk. Använd motsvarande version av Noah."
          }
        }
      }
    },
    "This backup was created by a newer version of Noah. Update the app, then try restoring again.": {
      "comment": "GT gt_f8225bade85a4f12; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was created by a newer version of Noah. Update the app, then try restoring again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad se creó con una versión más reciente de Noah. Actualiza la aplicación y vuelve a intentar restaurarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは、現在より新しいバージョンのNoahで作成されています。アプリを更新してから、もう一度復元をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 더 최신 버전의 Noah에서 생성되었습니다. 앱을 업데이트한 후 다시 복원하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här säkerhetskopian skapades med en nyare version av Noah. Uppdatera appen och försök sedan återställa igen."
          }
        }
      }
    },
    "This broadcasts the claim transaction. Earlier broadcast fees are not deducted again.": {
      "comment": "GT gt_42336142cf45ba47; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This broadcasts the claim transaction. Earlier broadcast fees are not deducted again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto difunde la transacción de reclamación. Las comisiones de difusión anteriores no se vuelven a descontar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け取りトランザクションをブロードキャストします。それまでのブロードキャスト手数料が再度差し引かれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "청구 트랜잭션을 전파합니다. 이전에 지불한 전파 수수료는 다시 차감되지 않습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta sänder inlösentransaktionen. Tidigare sändningsavgifter dras inte av igen."
          }
        }
      }
    },
    "This changes your wallet and can lose funds.": {
      "comment": "GT gt_58daedb7ce4a84c1; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes your wallet and can lose funds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto modifica tu billetera y puede hacerte perder fondos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットが変更され、資金を失う可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 변경되며 자금을 잃을 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här ändrar din plånbok och kan leda till förlorade pengar."
          }
        }
      }
    },
    "This differs from the {nativeValue1} sats you reviewed.": {
      "comment": "GT gt_dfa27aa18fe3eb7c; arguments: nativeValue1",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This differs from the %1$@ sats you reviewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este importe no coincide con los %1$@ sats que revisaste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先ほど確認した %1$@ sats と異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞서 확인한 %1$@ sats와 다른 금액입니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här skiljer sig från de %1$@ sats du granskade."
          }
        }
      }
    },
    "This does not cancel the original operation. Submitting again may spend additional funds or fees. Noah keeps this attempt and checks its status as your wallet syncs.": {
      "comment": "GT gt_9e3a6e3e9bd56700; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not cancel the original operation. Submitting again may spend additional funds or fees. Noah keeps this attempt and checks its status as your wallet syncs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no cancela la operación original. Volver a enviarla puede suponer un gasto adicional de fondos o comisiones. Noah conserva este intento y comprueba su estado mientras tu billetera se sincroniza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の操作は取り消されません。再送すると追加の資金や手数料が使われる場合があります。Noahはこの試行の記録を保持し、ウォレットの同期時に状態を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 작업은 취소되지 않습니다. 다시 제출하면 자금이나 수수료가 추가로 지출될 수 있습니다. Noah는 이번 시도를 기록해 두고 지갑 동기화 중에 상태를 확인합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta avbryter inte den ursprungliga åtgärden. Om du skickar igen kan ytterligare medel förbrukas eller avgifter tillkomma. Noah sparar försöket och kontrollerar dess status när plånboken synkroniseras."
          }
        }
      }
    },
    "This exit can no longer be canceled. Its final transaction may already be broadcast. Refresh its status.": {
      "comment": "GT gt_f2faa6b386bacbee; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This exit can no longer be canceled. Its final transaction may already be broadcast. Refresh its status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta salida ya no se puede cancelar. Es posible que su transacción final ya se haya difundido. Actualiza su estado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この退出はもう取り消せません。最終トランザクションがすでにブロードキャストされている可能性があります。状態を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 출금은 더 이상 취소할 수 없습니다. 최종 거래가 이미 전파되었을 수 있습니다. 상태를 새로 고치세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här nöduttaget kan inte längre avbrytas. Dess slutliga transaktion kan redan ha sänts. Uppdatera statusen."
          }
        }
      }
    },
    "This exit is behind the current chain height. Move it forward to catch up; this can also send exit transactions.": {
      "comment": "GT gt_5e306b07871ba45a; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This exit is behind the current chain height. Move it forward to catch up; this can also send exit transactions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta salida va por detrás de la altura actual de la cadena. Avánzala para ponerla al día; también puede enviar transacciones de salida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この出金は現在のチェーンの高さより遅れています。出金を進めて追いつかせてください。出金トランザクションが送信されることもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 출금은 현재 체인 높이보다 뒤처져 있어요. 출금을 진행해 따라잡으세요. 출금 트랜잭션을 보낼 수도 있어요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här uttaget ligger efter blockkedjans aktuella höjd. Flytta fram det för att komma ikapp; det kan också skicka uttagstransaktioner."
          }
        }
      }
    },
    "This exit is behind the current chain height: last checked {n} blocks ago, at block {height}. Moving it forward can also send exit transactions.": {
      "comment": "GT gt_02ca5673a1cb2959; arguments: n, height",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This exit is behind the current chain height: last checked %1$lld block ago, at block %2$@. Moving it forward can also send exit transactions."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This exit is behind the current chain height: last checked %1$lld blocks ago, at block %2$@. Moving it forward can also send exit transactions."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Esta salida va por detrás de la altura actual de la cadena: se revisó por última vez en el bloque %2$@, hace %1$lld bloque. Avanzarla también puede enviar transacciones de salida."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Esta salida va por detrás de la altura actual de la cadena: se revisó por última vez en el bloque %2$@, hace %1$lld bloques. Avanzarla también puede enviar transacciones de salida."
                }
