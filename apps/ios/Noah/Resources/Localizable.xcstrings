    "Fee estimate unavailable. Fees and amount to receive are unknown. Continue without an estimate only if you accept this uncertainty.": {
      "comment": "GT c9031271802cfba8; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fee estimate unavailable. Fees and amount to receive are unknown. Continue without an estimate only if you accept this uncertainty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una estimación de comisiones disponible. Se desconocen las comisiones y el importe que recibirás. Continúa sin estimación solo si aceptas esta incertidumbre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手数料を見積もれないため、手数料と受取額は不明です。この点を了承する場合のみ、見積もりなしで続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 수수료를 확인할 수 없어 수수료와 수령액을 알 수 없습니다. 이러한 불확실성을 감수할 수 있는 경우에만 계속하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avgifterna kan inte beräknas. Avgifterna och beloppet du får är okända. Fortsätt utan beräkning endast om du accepterar denna osäkerhet."
          }
        }
      }
    },
