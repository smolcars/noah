    "Exit progression returned {nativeValue1} errors. Transactions may have been broadcast or fee-bumped. Refresh exit details before continuing.": {
      "comment": "GT gt_0cb3378726d1acba; arguments: nativeValue1",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit progression returned %1$@ errors. Transactions may have been broadcast or fee-bumped. Refresh exit details before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se produjeron %1$@ errores al avanzar la salida. Es posible que se hayan difundido transacciones o aumentado sus comisiones. Actualiza los detalles de la salida antes de continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退出処理で%1$@件のエラーが発生しました。取引がブロードキャストされたか、手数料が引き上げられた可能性があります。続行する前に退出の詳細を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출금 진행 중 오류가 %1$@개 발생했습니다. 거래가 전파되었거나 수수료가 인상되었을 수 있습니다. 계속하기 전에 출금 세부 정보를 새로고침하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fortsatta hanteringen av nöduttaget gav %1$@ fel. Transaktioner kan ha sänts eller fått höjda avgifter. Uppdatera nöduttagets detaljer innan du fortsätter."
          }
        }
      }
    },
    "Exit started. Noah progresses it automatically in the background, paying broadcast and fee-bump fees from your onchain balance.": {
      "comment": "GT gt_1bc751fa07b37246; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit started. Noah progresses it automatically in the background, paying broadcast and fee-bump fees from your onchain balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salida iniciada. Noah la hace avanzar automáticamente en segundo plano y usa tu saldo en cadena para cubrir las comisiones de difusión y los aumentos de comisión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退出を開始しました。Noahはバックグラウンドで自動的に処理を進め、ブロードキャストと手数料引き上げにかかる費用をオンチェーン残高から支払います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출금이 시작되었습니다. Noah가 백그라운드에서 자동으로 진행하며, 거래 전파 및 수수료 인상에 드는 비용은 온체인 잔액에서 지불합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nöduttag startat. Noah hanterar det automatiskt i bakgrunden och betalar avgifter för sändning och avgiftshöjning från ditt saldo på blockkedjan."
          }
        }
      }
    },
    "Exit status is unavailable. Pull to refresh.": {
      "comment": "GT gt_899bbd05c2743f78; arguments: none",
      "extractionState": "manual",
      "localizations": {
