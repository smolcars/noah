    "Ask to board to Ark when onchain balance can cover {nativeValue1} sats plus fees while leaving at least 5,000 sats onchain. Confirm the exact fees and reserve before boarding.": {
      "comment": "Native-only copy; no RN translation. Intentionally English.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask to board to Ark when onchain balance can cover %1$@ sats plus fees while leaving at least 5,000 sats onchain. Confirm the exact fees and reserve before boarding."
          }
        }
      }
    },
    "Ask to board to Ark when onchain balance can cover {threshold}, estimated fees, and a {reserve} reserve.": {
      "comment": "GT 4a57df65091afdff; arguments: threshold, reserve",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask to board to Ark when onchain balance can cover %1$@, estimated fees, and a %2$@ reserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar si se desea transferir fondos a Ark cuando el saldo en cadena pueda cubrir %1$@, las comisiones estimadas y una reserva de %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンチェーン残高が%1$@、推定手数料、予備資金%2$@の合計額を満たすと、Arkに入金するか確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온체인 잔액으로 기준 금액 %1$@, 예상 수수료, 예비금 %2$@까지 충당할 수 있으면 Ark에 입금할지 묻습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga om att sätta in på Ark när saldot på kedjan täcker %1$@, beräknade avgifter och en reserv på %2$@."
          }
        }
      }
    },
