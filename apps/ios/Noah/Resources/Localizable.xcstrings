      }
    },
    "VTXOs below {_gt_value_2} cannot exit onchain. They are excluded from this exit.": {
      "comment": "GT 0993664bac131307; arguments: _gt_value_2",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VTXOs below %1$@ cannot exit onchain. They are excluded from this exit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los VTXOs de menos de %1$@ no pueden retirarse en cadena. Se excluyen de esta salida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額が%1$@未満のVTXOはオンチェーンで出金できないため、この出金の対象から除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 미만인 VTXO는 온체인으로 출금할 수 없어 이번 출금에서 제외됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VTXO:er med ett värde under %1$@ kan inte tas ut till blockkedjan via nöduttag. De ingår inte i detta nöduttag."
          }
        }
      }
    },
    "VTXOs keep refreshing in the background so they don't expire while the app is closed.": {
      "comment": "GT 0e3c50affc86b75f; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VTXOs keep refreshing in the background so they don't expire while the app is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los VTXO siguen renovándose en segundo plano para que no caduquen mientras la aplicación está cerrada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを閉じている間もVTXOが期限切れにならないよう、バックグラウンドで更新を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 닫혀 있어도 VTXO가 만료되지 않도록 백그라운드에서 계속 갱신됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VTXO:er fortsätter att förnyas i bakgrunden så att de inte löper ut när appen är stängd."
          }
        }
      }
    },
