{
  "sourceLanguage": "en",
  "strings": {
    " ({count} taps to unlock debug)": {
      "comment": "GT 2058f86cd24ad13b; arguments: count",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (%1$@ taps to unlock debug)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (%1$@ toques para desbloquear la depuración)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " （あと%1$@回タップでデバッグを有効化）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " (디버그 잠금 해제까지 %1$@번 탭)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": " (%1$@ tryck för att låsa upp felsökning)"
          }
        }
      }
    },
    " Claim fee updates when you enter a destination at the claim stage.": {
      "comment": "GT 3b70f0de936ce446; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Claim fee updates when you enter a destination at the claim stage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " La comisión de reclamación se actualiza cuando introduces un destino en la etapa de reclamación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 受け取り段階で送金先を入力すると、受け取り手数料が更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 청구 단계에서 수령 주소를 입력하면 청구 수수료가 갱신됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": " Inlösenavgiften uppdateras när du anger en destination i inlösensteget."
          }
        }
      }
    },
    " Earlier broadcast fees are not deducted again.": {
      "comment": "GT c67f83a73ce7420e; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Earlier broadcast fees are not deducted again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Las comisiones de difusión anteriores no se descuentan de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " すでに支払ったブロードキャスト手数料が再び差し引かれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 이전에 지불한 전파 수수료는 다시 차감되지 않습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": " Tidigare sändningsavgifter dras inte av igen."
          }
        }
      }
    },
