    "A custom Esplora server can observe the Bitcoin addresses and transactions requested by this wallet. Only use a server you trust.": {
      "comment": "GT gt_ca4925ac35b345a4; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom Esplora server can observe the Bitcoin addresses and transactions requested by this wallet. Only use a server you trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servidor Esplora personalizado puede ver las direcciones y transacciones de Bitcoin que consulta esta billetera. Usa solo un servidor en el que confíes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムEsploraサーバーは、このウォレットが照会するBitcoinアドレスや取引を確認できます。信頼できるサーバーのみを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 Esplora 서버는 이 지갑이 조회하는 Bitcoin 주소와 거래를 확인할 수 있습니다. 신뢰할 수 있는 서버만 사용하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En anpassad Esplora-server kan se vilka Bitcoin-adresser och transaktioner plånboken begär information om. Använd bara en server som du litar på."
          }
        }
      }
    },
    "A payment of {amount} sats for this invoice is already in progress. Do not pay again.": {
      "comment": "GT gt_51eedf36dc1a1749; arguments: amount",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A payment of %1$@ sats for this invoice is already in progress. Do not pay again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un pago de %1$@ sats en curso para esta solicitud de pago. No vuelvas a pagar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この請求書への%1$@ satsの支払いはすでに処理中です。再度支払わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결제 요청서에 대한 %1$@ sats 결제가 이미 진행 중입니다. 다시 결제하지 마세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En betalning på %1$@ sats för den här betalningsbegäran pågår redan. Betala inte igen."
          }
        }
      }
    },
