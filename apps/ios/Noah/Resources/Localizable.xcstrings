    "Status remains uncertain. Noah checks again automatically as your wallet syncs.": {
      "comment": "GT gt_1c23c9a0a6a0b504; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status remains uncertain. Noah checks again automatically as your wallet syncs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado sigue siendo incierto. Noah volverá a comprobarlo automáticamente a medida que se sincronice tu billetera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状況はまだ確定していません。ウォレットの同期時にNoahが自動的に再確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 상태가 불확실합니다. 지갑이 동기화될 때 Noah가 자동으로 다시 확인합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Status är fortfarande osäker. Noah kontrollerar automatiskt igen när din plånbok synkroniseras."
          }
        }
      }
    },
