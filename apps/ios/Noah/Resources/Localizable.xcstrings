            "value": "Noah puede recibir y renovar aunque esté cerrado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahを閉じていても受け取りと更新ができます。"
          }
        },
        "ko": {
