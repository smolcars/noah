        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見積もりの合計は%1$@ですが、%2$@残高は%3$@です。最終的な手数料が見積もりより低くならない場合、送金に失敗する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 총액은 %1$@이지만 %2$@ 잔액은 %3$@입니다. 최종 수수료가 더 낮아지지 않으면 전송에 실패할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den beräknade totalsumman är %1$@, men ditt saldo för %2$@ är %3$@. Överföringen kan misslyckas om den slutliga avgiften inte blir lägre."
          }
        }
      }
