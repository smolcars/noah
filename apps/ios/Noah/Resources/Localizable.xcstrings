        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre y el asunto deben ocupar un máximo de 150 bytes cada uno, y el mensaje, un máximo de 60 000 bytes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と件名はそれぞれ150バイト以内、メッセージは60,000バイト以内にしてください。"
