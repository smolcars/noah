    },
    "This action is irreversible. Your wallet and its recovery phrase will be removed from this device. Make sure you have your recovery phrase or a backup before you continue.": {
      "comment": "GT gt_52d68c1550b8eb0c; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action is irreversible. Your wallet and its recovery phrase will be removed from this device. Make sure you have your recovery phrase or a backup before you continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción es irreversible. Tu billetera y su frase de recuperación se eliminarán de este dispositivo. Asegúrate de tener tu frase de recuperación o una copia de seguridad antes de continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は元に戻せません。ウォレットと復元フレーズがこの端末から削除されます。続行する前に、復元フレーズまたはバックアップが手元にあることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없습니다. 이 기기에서 지갑과 복구 문구가 삭제됩니다. 계속하기 전에 복구 문구 또는 백업이 있는지 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här åtgärden kan inte ångras. Din plånbok och dess återställningsfras tas bort från den här enheten. Se till att du har din återställningsfras eller en säkerhetskopia innan du fortsätter."
          }
        }
      }
    },
    "This address isn't in your Noah wallet. The claimed funds will be sent there.": {
      "comment": "GT gt_69d8d757288ce17b; arguments: none",
      "extractionState": "manual",
      "localizations": {
