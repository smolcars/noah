        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認内容の有効期限が切れました。支払い内容を再確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 검토 시간이 만료되었습니다. 결제 내용을 다시 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här granskningen är inte längre giltig. Granska betalningen igen."
          }
        }
      }
    },
    "This saved payment outcome could not be verified. It may have been sent. Check history before sending again.": {
      "comment": "GT gt_7d8163bb0233e286; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved payment outcome could not be verified. It may have been sent. Check history before sending again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el resultado guardado de este pago. Es posible que se haya enviado. Revisa el historial antes de volver a enviarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたこの支払いの結果を確認できませんでした。送金済みの可能性があります。再送する前に履歴を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결제의 저장된 결과를 검증하지 못했습니다. 이미 전송되었을 수 있습니다. 다시 보내기 전에 기록을 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utfallet för den här sparade betalningen kunde inte verifieras. Betalningen kan ha skickats. Kontrollera historiken innan du skickar igen."
          }
        }
      }
    },
    "This schedule has more than 5,000 missed occurrences. Cancel it and create a schedule with a future first payment.": {
      "comment": "GT gt_156e3ae53af506dd; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This schedule has more than 5,000 missed occurrences. Cancel it and create a schedule with a future first payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta programación tiene más de 5000 pagos omitidos. Cancélala y crea una programación con el primer pago en una fecha futura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスケジュールには、予定日時を過ぎた未実行の支払いが5,000回を超えてあります。キャンセルし、初回の支払い日が今後の日付になるスケジュールを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 일정에서 결제가 5,000회 넘게 누락되었습니다. 일정을 취소하고 첫 결제일을 미래로 설정한 새 일정을 만드세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här schemat har fler än 5 000 missade betalningstillfällen. Avsluta det och skapa ett schema där den första betalningen ligger i framtiden."
          }
        }
      }
    },
    "This signed transaction expires after two minutes. Review again for a fresh fee rate.": {
      "comment": "GT gt_fa9699d246ed7062; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This signed transaction expires after two minutes. Review again for a fresh fee rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transacción firmada caduca a los dos minutos. Revísala de nuevo para obtener una tasa de comisión actualizada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この署名済み取引は2分後に有効期限が切れます。最新の手数料率を取得するには、もう一度内容を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서명된 거래는 2분 후에 만료됩니다. 최신 수수료율이 적용되도록 다시 검토하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här signerade transaktionen upphör att gälla efter två minuter. Granska den igen för att få en aktuell avgiftsnivå."
          }
        }
      }
    },
    "This transaction cannot confirm on the current chain: a confirmed different transaction ({nativeValue1}) spends one of its inputs.": {
      "comment": "GT gt_d9302348c16e07a5; arguments: nativeValue1",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This transaction cannot confirm on the current chain: a confirmed different transaction (%1$@) spends one of its inputs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transacción no puede confirmarse en la cadena actual: otra transacción confirmada (%1$@) gasta una de sus entradas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトランザクションは現在のチェーンでは確認済みになりません。入力の1つが、確認済みの別のトランザクション（%1$@）ですでに使用されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 확정된 다른 거래(%1$@)가 이 거래의 입력 중 하나를 사용했으므로 현재 체인에서는 이 거래가 확정될 수 없습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här transaktionen kan inte bekräftas på den aktuella kedjan: en annan bekräftad transaktion (%1$@) förbrukar en av dess indata."
          }
        }
      }
    },
