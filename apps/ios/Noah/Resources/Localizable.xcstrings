    "Noah has not confirmed the final outcome. Do not pay again. Checking status will never submit another payment.": {
      "comment": "GT gt_9bbbe9d436c3e3e3; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah has not confirmed the final outcome. Do not pay again. Checking status will never submit another payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no ha confirmado el resultado final. No vuelvas a pagar. Consultar el estado nunca provoca el envío de otro pago."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahは最終結果を確認できていません。再度支払わないでください。状態の確認によって別の支払いが送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 최종 결과를 확인하지 못했습니다. 다시 결제하지 마세요. 상태 확인으로는 새 결제가 제출되지 않습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah har inte bekräftat det slutliga utfallet. Betala inte igen. En statuskontroll skickar aldrig en ny betalning."
          }
        }
      }
    },
