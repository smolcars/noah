    "Location is unavailable. Check that location is enabled, or search for a city.": {
      "comment": "GT gt_2df39c51ede8a438; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is unavailable. Check that location is enabled, or search for a city."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación no está disponible. Comprueba que esté activada o busca una ciudad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を取得できません。位置情報が有効になっているか確認するか、都市を検索してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 확인할 수 없습니다. 위치 기능이 켜져 있는지 확인하거나 도시를 검색하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plats är inte tillgänglig. Kontrollera att platstjänster är aktiverade eller sök efter en stad."
          }
        }
      }
    },
    "Location is unavailable. You can still search for a city and browse the full map.": {
