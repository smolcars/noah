    "Recurring payment data couldn't be read. Your saved schedules have been preserved. Sending is stopped.": {
      "comment": "GT gt_e96cc9747bde094a; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurring payment data couldn't be read. Your saved schedules have been preserved. Sending is stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los datos de pagos recurrentes. Se han conservado tus programaciones guardadas. Los envíos están detenidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期支払いデータを読み取れませんでした。保存済みのスケジュールは保持されています。送金は停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기 결제 데이터를 읽지 못했습니다. 저장된 결제 예약은 그대로 보존되었습니다. 전송이 중지되었습니다."
          }
        },
        "sv": {
