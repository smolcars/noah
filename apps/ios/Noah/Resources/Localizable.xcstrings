          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la transacción. No se envió ningún pago. Revisa el importe y la comisión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引を作成できませんでした。支払いは送信されていません。金額と手数料を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
