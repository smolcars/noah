        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la transacción. No se difundió nada. Vuelve a revisarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションを作成できませんでした。何もブロードキャストされていません。内容をもう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래를 구성하지 못했습니다. 아무것도 전파되지 않았습니다. 다시 검토해 주세요."
          }
        },
        "sv": {
