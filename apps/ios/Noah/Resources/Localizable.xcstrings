    "The backup's wallet information doesn't match. Noah couldn't safely restore it.": {
      "comment": "GT gt_fbf76b6ef0e4a918; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup's wallet information doesn't match. Noah couldn't safely restore it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información de la billetera en la copia de seguridad no coincide. Noah no pudo restaurarla de forma segura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ内のウォレット情報が一致しないため、Noahで安全に復元できませんでした。"
