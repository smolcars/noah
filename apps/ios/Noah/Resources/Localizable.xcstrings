    "Saved settings could not be read. Keep Noah installed and contact support.": {
      "comment": "GT gt_dde05b647d6f58a4; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved settings could not be read. Keep Noah installed and contact support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la configuración guardada. No desinstales Noah y contacta con el servicio de soporte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの設定を読み取れませんでした。Noahをアンインストールせずに、サポートにお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 설정을 읽을 수 없습니다. Noah를 삭제하지 말고 지원팀에 문의하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparade inställningar kunde inte läsas. Låt Noah vara installerat och kontakta supporten."
          }
        }
      }
    },
    "Saving starts a new schedule at the first payment date. Previous attempts remain visible.": {
      "comment": "GT gt_8908ecb9a084f6eb; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving starts a new schedule at the first payment date. Previous attempts remain visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar, se inicia una nueva programación a partir de la fecha del primer pago. Los intentos anteriores seguirán visibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、初回支払日から新しいスケジュールが始まります。過去の試行は引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 첫 결제일부터 새 일정이 시작됩니다. 이전 시도 내역은 계속 표시됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du sparar börjar ett nytt schema gälla från det första betalningsdatumet. Tidigare försök visas fortfarande."
          }
        }
      }
    },
