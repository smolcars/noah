    "Each one is sent only after the one before it is in a block.": {
      "comment": "GT gt_a8652bad1788fdd8; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each one is sent only after the one before it is in a block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada una se envía solo cuando la anterior está en un bloque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各トランザクションは、前のものがブロックに入ってから送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 트랜잭션은 이전 트랜잭션이 블록에 들어간 뒤에만 보내져요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var och en skickas först när den före är med i ett block."
          }
        }
      }
    },
    "Each transaction’s fee comes from your confirmed on-chain bitcoin. Noah sends the next one once a deposit confirms.": {
      "comment": "GT gt_985a8feacc07a757; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each transaction’s fee comes from your confirmed on-chain bitcoin. Noah sends the next one once a deposit confirms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión de cada transacción sale de tus bitcoins en cadena confirmados. Noah envía la siguiente cuando se confirme un depósito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各トランザクションの手数料は、承認済みのオンチェーンのビットコインから支払われます。入金が承認されると、Noahが次のトランザクションを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 트랜잭션의 수수료는 확정된 온체인 비트코인에서 나가요. 입금이 확정되면 Noah가 다음 트랜잭션을 보내요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje transaktions avgift tas från dina bekräftade bitcoin på blockkedjan. Noah skickar nästa när en insättning har bekräftats."
          }
        }
      }
    },
