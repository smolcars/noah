    "{n} exits are behind the current chain height. Move any of them forward to catch up; this can also send exit transactions.": {
      "comment": "GT gt_cea13885ad32653d; arguments: n",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One exit is behind the current chain height. Move it forward to catch up; this can also send exit transactions."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld exits are behind the current chain height. Move any of them forward to catch up; this can also send exit transactions."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una salida está por detrás de la altura actual de la cadena. Avánzala para ponerla al día; esto también puede enviar transacciones de salida."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld salidas están por detrás de la altura actual de la cadena. Avanza cualquiera de ellas para ponerlas al día; esto también puede enviar transacciones de salida."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1件の出金が現在のチェーンの高さより遅れています。その出金を進めて追いつかせてください。出金トランザクションが送信される場合もあります。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld件の出金が現在のチェーンの高さより遅れています。いずれかの出金を進めて追いつかせてください。出金トランザクションが送信される場合もあります。"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "출금 1건이 현재 체인 높이보다 뒤처져 있습니다. 해당 출금을 진행해 따라잡으세요. 이 과정에서 출금 거래를 보낼 수도 있습니다."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "출금 %1$lld건이 현재 체인 높이보다 뒤처져 있습니다. 아무 출금이나 진행해 따라잡으세요. 이 과정에서 출금 거래를 보낼 수도 있습니다."
                }
              }
            }
          }
        },
        "sv": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ett nöduttag ligger efter den aktuella blockhöjden. Flytta fram det för att komma ikapp. Det kan även innebära att nöduttagstransaktioner skickas."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld nöduttag ligger efter den aktuella blockhöjden. Flytta fram något av dem för att komma ikapp. Det kan även innebära att nöduttagstransaktioner skickas."
                }
              }
            }
          }
        }
      }
    },
    "{n} exits from one round: {count} transactions, not {total}. Shared ones are sent and paid once.": {
