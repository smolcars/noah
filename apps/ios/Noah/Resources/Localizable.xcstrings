        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att kontrollera den här betalningen. Den kan redan pågå. Kontrollera status innan du skickar igen."
          }
        }
      }
    },
    "Unable to load saved payment status. Check your history and recipient before forgetting this attempt.": {
      "comment": "GT gt_f9ce4ec1f84197b7; arguments: none",
      "extractionState": "manual",
