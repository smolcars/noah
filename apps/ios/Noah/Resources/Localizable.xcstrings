          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pago heredado no tiene una identidad de billetera asociada. Comprueba tu historial y el destinatario antes de descartarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
