      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without optimization, notifications can drop off completely, not just be delayed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin optimización, las notificaciones pueden dejar de llegar por completo, no solo retrasarse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最適化しないと、通知が遅れるだけでなく、まったく届かなくなる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최적화하지 않으면 알림이 지연될 뿐 아니라 아예 오지 않을 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan optimering kan notiser utebli helt, inte bara försenas."
          }
        }
      }
    },
