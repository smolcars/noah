    "Notifications let Noah receive payments and renew your bitcoin before it expires.": {
      "comment": "GT gt_fce40565eda8090e; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications let Noah receive payments and renew your bitcoin before it expires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones permiten a Noah recibir pagos y renovar tu bitcoin antes de que caduque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知により、Noah は支払いを受け取り、ビットコインが期限切れになる前に更新できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 켜면 Noah가 결제를 받고 비트코인이 만료되기 전에 갱신할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med aviseringar kan Noah ta emot betalningar och förnya din bitcoin innan den löper ut."
          }
        }
      }
    },
