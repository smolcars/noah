    "Noah has not confirmed the final outcome. Do not pay again. Checking status will never submit another payment.": {
      "comment": "GT gt_9bbbe9d436c3e3e3; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah has not confirmed the final outcome. Do not pay again. Checking status will never submit another payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no ha confirmado el resultado final. No vuelvas a pagar. Consultar el estado nunca provoca el envío de otro pago."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahは最終結果を確認できていません。再度支払わないでください。状態の確認によって別の支払いが送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 최종 결과를 확인하지 못했습니다. 다시 결제하지 마세요. 상태 확인으로는 새 결제가 제출되지 않습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah har inte bekräftat det slutliga utfallet. Betala inte igen. En statuskontroll skickar aldrig en ny betalning."
          }
        }
      }
    },
    "Noah hasn’t checked on this exit in a while. Moving it forward can also send its next step or raise a fee.": {
      "comment": "GT gt_a8a0b1813d01e36a; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah hasn’t checked on this exit in a while. Moving it forward can also send its next step or raise a fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no ha revisado esta salida desde hace un rato. Avanzarla también puede enviar su siguiente paso o subir una comisión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahはしばらくこの出金を確認していません。出金を進めると、次のステップの送信や手数料の引き上げが行われることもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 한동안 이 출금을 확인하지 않았습니다. 출금을 진행하면 다음 단계를 보내거나 수수료를 올릴 수도 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah har inte kontrollerat det här nöduttaget på ett tag. Att flytta fram det kan också skicka nästa steg eller höja en avgift."
          }
        }
      }
    },
    "Noah is in beta. Only keep what you’re comfortable losing.": {
      "comment": "GT gt_9354e260e9c82293; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah is in beta. Only keep what you’re comfortable losing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah está en beta. Guarda solo lo que estés dispuesto a perder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah はベータ版です。失っても構わない金額だけを保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah는 베타 버전입니다. 잃어도 괜찮은 만큼만 보관하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah är i beta. Förvara bara det du har råd att förlora."
          }
        }
      }
    },
    "Noah is locked": {
