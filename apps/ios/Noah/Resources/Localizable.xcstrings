          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el estado guardado del pago. Revisa tu historial y el destinatario antes de descartar este intento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
