    "Recover funds if the Ark server is unavailable.": {
      "comment": "GT gt_0b9971b0e0b4f0e1; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover funds if the Ark server is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera tus fondos si el servidor Ark no está disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkサーバーが利用できない場合に資金を回収します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ark 서버를 사용할 수 없을 때 자금을 복구하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återfå medel om Ark-servern inte är tillgänglig."
          }
        }
      }
    },
    "Recover your Ark funds onchain if the Ark server is unavailable. Exits require confirmed onchain funds for broadcast fees and a timelock before claiming.": {
      "comment": "GT gt_3b208c8df3744b19; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover your Ark funds onchain if the Ark server is unavailable. Exits require confirmed onchain funds for broadcast fees and a timelock before claiming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera tus fondos de Ark en cadena si el servidor Ark no está disponible. Las salidas requieren fondos confirmados en cadena para cubrir las comisiones de difusión y un plazo de bloqueo antes de poder reclamar los fondos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkサーバーが利用できない場合に、Arkの資金をオンチェーンで回収します。退出にはブロードキャスト手数料を支払うための確認済みオンチェーン資金が必要です。また、受け取りにはタイムロック期間が過ぎるまで待つ必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ark 서버를 사용할 수 없을 때 Ark 자금을 온체인으로 복구하세요. 출금하려면 전파 수수료를 지불할 확정된 온체인 자금이 필요하며, 시간 잠금 기간이 지나야 청구할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återför dina Ark-medel till blockkedjan om Ark-servern inte är tillgänglig. Nöduttag kräver bekräftade medel på blockkedjan för sändningsavgifter, och ett tidslås måste löpa ut innan medlen kan lösas in."
          }
        }
      }
    },
