        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado, pendiente de difusión. Noah seguirá intentando difundirlo. No vuelvas a enviar este pago."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信済みで、ブロードキャスト待ちです。Noahはブロードキャストを引き続き試みます。この支払いを再送信しないでください。"
