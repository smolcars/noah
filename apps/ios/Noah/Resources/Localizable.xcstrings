          "stringUnit": {
            "state": "translated",
            "value": "저장된 설정을 읽을 수 없습니다. Noah를 삭제하지 말고 지원팀에 문의하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparade inställningar kunde inte läsas. Låt Noah vara installerat och kontakta supporten."
          }
        }
      }
    },
    "Saving starts a new schedule at the first payment date. Previous attempts remain visible.": {
      "comment": "GT gt_8908ecb9a084f6eb; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving starts a new schedule at the first payment date. Previous attempts remain visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar, se inicia una nueva programación a partir de la fecha del primer pago. Los intentos anteriores seguirán visibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、初回支払日から新しいスケジュールが始まります。過去の試行は引き続き表示されます。"
          }
