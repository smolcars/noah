        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지갑의 암호화된 사본이에요. 복원하려면 복구 문구가 필요해요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En krypterad kopia av plånboken. För att återställa den behövs din återställningsfras."
          }
        }
      }
    },
    "An existing Lightning payment will be checked. No new payment will be created.": {
