    "A payment to {recipient} was interrupted. Check your history, then resume it.": {
      "comment": "GT gt_f6a7e36fc225654b; arguments: recipient",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A payment to %1$@ was interrupted. Check your history, then resume it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interrumpió un pago a %1$@. Revisa tu historial y luego reanuda el pago."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@への支払いが中断されました。履歴を確認してから再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에게 보내던 결제가 중단되었습니다. 내역을 확인한 후 재개하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En betalning till %1$@ avbröts. Kontrollera historiken och återuppta sedan betalningen."
          }
        }
      }
    },
