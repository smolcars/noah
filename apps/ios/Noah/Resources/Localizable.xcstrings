    },
    "Noah can't read its secure storage yet. Unlock your device to continue.": {
      "comment": "GT gt_966bc2f318542271; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah can't read its secure storage yet. Unlock your device to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah aún no puede leer su almacenamiento seguro. Desbloquea tu dispositivo para continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahはまだセキュアストレージを読み取れません。続行するには端末のロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 아직 보안 저장소를 읽을 수 없습니다. 계속하려면 기기 잠금을 해제하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kan inte läsa sin säkra lagring ännu. Lås upp enheten för att fortsätta."
          }
        }
      }
    },
    "Noah can't reconstruct this schedule's earlier payment history. Cancel it and explicitly approve a new recurring payment.": {
      "comment": "GT gt_072dd91b690ac073; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah can't reconstruct this schedule's earlier payment history. Cancel it and explicitly approve a new recurring payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no puede reconstruir el historial de pagos previos de esta programación. Cancélala y aprueba explícitamente un nuevo pago recurrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahはこのスケジュールの過去の支払い履歴を復元できません。このスケジュールをキャンセルし、新しい定期支払いを明示的に承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 이 일정의 이전 결제 내역을 재구성할 수 없습니다. 일정을 취소하고 새 정기 결제를 직접 승인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kan inte återskapa schemats tidigare betalningshistorik. Avsluta schemat och godkänn uttryckligen en ny återkommande betalning."
          }
        }
      }
    },
    "Noah can't safely read this schedule. Cancel it and explicitly approve a new recurring payment.": {
      "comment": "GT gt_a0bdac1d74ff4bfc; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah can't safely read this schedule. Cancel it and explicitly approve a new recurring payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no puede leer esta programación de forma segura. Cancélala y aprueba explícitamente un nuevo pago recurrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahはこのスケジュールを安全に読み取れません。キャンセルしてから、新しい定期支払いを明示的に承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 이 일정을 안전하게 읽을 수 없습니다. 일정을 취소하고 새 정기 결제를 직접 승인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kan inte läsa det här schemat på ett säkert sätt. Avbryt det och godkänn uttryckligen en ny återkommande betalning."
          }
        }
      }
    },
    "Noah can’t find this transaction right now. Its confirmation may no longer be trackable in-app. Check a block explorer.": {
      "comment": "GT gt_c1409d2c850b64e1; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah can’t find this transaction right now. Its confirmation may no longer be trackable in-app. Check a block explorer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no puede encontrar esta transacción en este momento. Es posible que ya no se pueda comprobar su confirmación desde la aplicación. Consulta un explorador de bloques."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、Noahでこの取引が見つかりません。アプリ内では確認状況を追跡できなくなっている可能性があります。ブロックエクスプローラーで確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 현재 이 거래를 찾을 수 없습니다. 앱에서 더 이상 확정 여부를 추적할 수 없을 수도 있습니다. 블록 탐색기에서 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kan inte hitta den här transaktionen just nu. Det kanske inte längre går att se i appen om den har bekräftats. Kontrollera i en blockutforskare."
          }
        }
      }
    },
    "Noah can’t receive payments or renew your bitcoin.": {
      "comment": "GT gt_55b9a93591fa4702; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah can’t receive payments or renew your bitcoin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no puede recibir pagos ni renovar tu bitcoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahは支払いを受け取れず、ビットコインを更新することもできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 결제를 받거나 비트코인을 갱신할 수 없어요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kan inte ta emot betalningar eller förnya din bitcoin."
          }
        }
      }
    },
    "Noah checks again automatically as your wallet syncs.": {
      "comment": "GT gt_69015317a2b04485; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah checks again automatically as your wallet syncs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah vuelve a comprobarlo automáticamente mientras se sincroniza tu billetera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットの同期に合わせて、Noahが自動的に再確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 동기화되는 동안 Noah가 자동으로 다시 확인합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kontrollerar automatiskt igen när din plånbok synkroniseras."
          }
        }
      }
    },
    "Noah checks it’s on the right network before switching.": {
      "comment": "GT gt_c2fe2ee25b70bb73; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah checks it’s on the right network before switching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah comprueba que esté en la red correcta antes de cambiar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替える前に、Noahが正しいネットワークかどうかを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환하기 전에 Noah가 올바른 네트워크인지 확인해요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kontrollerar att den är på rätt nätverk innan bytet."
          }
        }
      }
    },
    "Noah closes the wallet and stops payments until you turn this off.": {
      "comment": "GT gt_5a00f75927a33884; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah closes the wallet and stops payments until you turn this off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah cierra la billetera y detiene los pagos hasta que desactives esta opción."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをオフにするまで、Noahはウォレットを閉じて支払いを停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정을 끌 때까지 Noah가 지갑을 닫고 결제를 중지해요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah stänger plånboken och stoppar betalningar tills du stänger av det här."
          }
        }
      }
    },
    "Noah could not read or save the payment attempt. Sending is disabled until its status can be recovered.": {
      "comment": "GT gt_c1f6e702ec74583d; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah could not read or save the payment attempt. Sending is disabled until its status can be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no pudo leer ni guardar el intento de pago. El envío está desactivado hasta que se pueda recuperar su estado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahは支払い試行の記録を読み取るか保存する際に失敗しました。状況を復元できるまで送信は無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 결제 시도 내역을 읽거나 저장하지 못했습니다. 상태를 복구할 때까지 전송이 비활성화됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kunde inte läsa eller spara betalningsförsöket. Det går inte att skicka förrän dess status kan återställas."
          }
        }
      }
    },
    "Noah couldn't access secure storage. Unlock your device and try again.": {
      "comment": "GT gt_34c9cafb61bbac7d; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah couldn't access secure storage. Unlock your device and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no pudo acceder al almacenamiento seguro. Desbloquea tu dispositivo e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahが安全な保存領域にアクセスできませんでした。端末のロックを解除して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 보안 저장소에 접근하지 못했습니다. 기기 잠금을 해제하고 다시 시도해 주세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kunde inte komma åt den säkra lagringen. Lås upp enheten och försök igen."
          }
        }
      }
    },
    "Noah couldn't confirm that your recovery phrase was saved. Do not retry. Unlock your device, then close and restart Noah to recover safely.": {
      "comment": "GT gt_e107aa3075b29c81; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah couldn't confirm that your recovery phrase was saved. Do not retry. Unlock your device, then close and restart Noah to recover safely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no pudo confirmar que tu frase de recuperación se hubiera guardado. No lo intentes de nuevo. Desbloquea tu dispositivo y luego cierra y reinicia Noah para realizar la recuperación de forma segura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahは復元フレーズが保存されたことを確認できませんでした。再試行しないでください。安全に復旧するため、端末のロックを解除してから、Noahを閉じて再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 복구 문구의 저장 여부를 확인하지 못했습니다. 다시 시도하지 마세요. 안전하게 복구하려면 기기 잠금을 해제한 다음 Noah를 종료하고 다시 시작하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kunde inte bekräfta att din återställningsfras sparades. Försök inte igen. Lås upp enheten. Stäng sedan Noah och starta om appen för en säker återställning."
          }
        }
      }
    },
    "Noah couldn't download your backup. Check your internet connection and try again.": {
      "comment": "GT gt_3c1e8037a80178df; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah couldn't download your backup. Check your internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no pudo descargar tu copia de seguridad. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahがバックアップをダウンロードできませんでした。インターネット接続を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 백업을 다운로드하지 못했습니다. 인터넷 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kunde inte hämta din säkerhetskopia. Kontrollera internetanslutningen och försök igen."
          }
        }
      }
    },
    "Noah couldn't finish or undo an interrupted restore. Your wallet files were left as they are. Restart Noah to try again.": {
      "comment": "GT gt_e92407ae0cc29539; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah couldn't finish or undo an interrupted restore. Your wallet files were left as they are. Restart Noah to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no pudo completar ni deshacer una restauración interrumpida. Los archivos de tu billetera se han dejado intactos. Reinicia Noah para intentarlo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahは中断された復元を完了することも取り消すこともできませんでした。ウォレットのファイルはそのまま保持されています。Noahを再起動して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 중단된 복원을 완료하거나 되돌리지 못했습니다. 지갑 파일은 그대로 유지되었습니다. 다시 시도하려면 Noah를 다시 시작하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kunde inte slutföra eller ångra en avbruten återställning. Dina plånboksfiler har lämnats oförändrade. Starta om Noah för att försöka igen."
          }
        }
      }
    },
    "Noah couldn't open the restored wallet safely. Close and restart Noah to continue.": {
      "comment": "GT gt_8ad019accd01ac95; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah couldn't open the restored wallet safely. Close and restart Noah to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah no pudo abrir la billetera restaurada de forma segura. Cierra y reinicia Noah para continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noahが復元されたウォレットを安全に開けませんでした。続行するにはNoahを閉じて再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah가 복원된 지갑을 안전하게 열지 못했습니다. 계속하려면 Noah를 종료한 후 다시 시작하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kunde inte öppna den återställda plånboken på ett säkert sätt. Stäng och starta om Noah för att fortsätta."
          }
        }
      }
    },
    "Noah couldn't remove temporary wallet files. Restart Noah and try again.": {
      "comment": "GT gt_55037f1fddcada0f; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
