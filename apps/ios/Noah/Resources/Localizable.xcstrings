    "A block came without it. Noah pays more when the fee rate rises, so it gets into the next one.": {
      "comment": "GT gt_93308a413f52ce7d; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A block came without it. Noah pays more when the fee rate rises, so it gets into the next one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegó un bloque sin ella. Noah paga más cuando sube la tasa de comisión, para que entre en el siguiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトランザクションを含まないブロックが来ました。手数料率が上がるとNoahはより多く支払い、次のブロックに入るようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 트랜잭션 없이 블록이 생성됐어요. 수수료율이 오르면 Noah가 더 지불해서 다음 블록에 들어가게 해요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett block kom utan den. Noah betalar mer när avgiftsnivån stiger, så att den kommer med i nästa."
          }
        }
      }
    },
    "A custom server can see your addresses. Use one you trust.": {
      "comment": "GT gt_1ef4529eb54eae53; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom server can see your addresses. Use one you trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servidor personalizado puede ver tus direcciones. Usa uno de confianza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムサーバーにはあなたのアドレスが見えます。信頼できるサーバーを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 서버는 내 주소를 볼 수 있어요. 신뢰할 수 있는 서버를 사용하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En anpassad server kan se dina adresser. Använd en du litar på."
          }
        }
      }
    },
    "A payment of {amount} sats for this invoice is already in progress. Do not pay again.": {
      "comment": "GT gt_51eedf36dc1a1749; arguments: amount",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A payment of %1$@ sats for this invoice is already in progress. Do not pay again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un pago de %1$@ sats en curso para esta solicitud de pago. No vuelvas a pagar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この請求書への%1$@ satsの支払いはすでに処理中です。再度支払わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결제 요청서에 대한 %1$@ sats 결제가 이미 진행 중입니다. 다시 결제하지 마세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En betalning på %1$@ sats för den här betalningsbegäran pågår redan. Betala inte igen."
          }
        }
      }
    },
    "A payment of {nativeValue1} sats for this invoice is already in progress. Do not pay again.": {
