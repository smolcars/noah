        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 확인할 수 없습니다. 위치 기능이 켜져 있는지 확인하거나 도시를 검색하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plats är inte tillgänglig. Kontrollera att platstjänster är aktiverade eller sök efter en stad."
          }
        }
      }
    },
    "Location is unavailable. You can still search for a city and browse the full map.": {
