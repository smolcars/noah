    "\"If you don't believe it or don't get it, I don't have time to try to convince you, sorry.\" - Satoshi Nakamoto": {
      "comment": "GT 27ee58dfd29c2b1b; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"If you don't believe it or don't get it, I don't have time to try to convince you, sorry.\" - Satoshi Nakamoto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Si no lo crees o no lo entiendes, no tengo tiempo para intentar convencerte, lo siento.» - Satoshi Nakamoto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「信じられない、あるいは理解できないというなら、あなたを説得する時間はありません。すみません。」— サトシ・ナカモト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"믿지 못하거나 이해하지 못한다면, 미안하지만 설득할 시간은 없습니다.\" - 나카모토 사토시"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”Om du inte tror på det eller inte förstår det har jag inte tid att försöka övertyga dig, tyvärr.” – Satoshi Nakamoto"
          }
        }
      }
    },
    "#{nativeValue1} · {nativeValue2} · {nativeValue3} sats": {
      "comment": "Native-only copy; no RN translation. Intentionally English.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "#%1$@ · %2$@ · %3$@ sats"
          }
        }
      }
    },
    "6-digit code": {
