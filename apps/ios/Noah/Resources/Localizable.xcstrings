            "value": "No se pudo guardar la posición del mapa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図の表示位置を保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도 위치를 저장하지 못했습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
