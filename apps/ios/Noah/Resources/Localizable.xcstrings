    "This refreshes the selected VTXOs in a delegated Ark round.": {
      "comment": "GT gt_5d5cfeffe0f4ad97; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This refreshes the selected VTXOs in a delegated Ark round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción renueva los VTXOs seleccionados en una ronda delegada de Ark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "委任されたArkラウンドで選択したVTXOを更新します。"
          }
        },
        "ko": {
          "stringUnit": {
