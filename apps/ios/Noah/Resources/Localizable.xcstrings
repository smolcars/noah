    "This invoice was already paid. This occurrence was not sent again. Check the recipient before resuming.": {
      "comment": "GT gt_5ed0c20bff01c0ca; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invoice was already paid. This occurrence was not sent again. Check the recipient before resuming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud de pago ya está pagada. Este pago programado no se volvió a enviar. Comprueba el destinatario antes de reanudar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この請求書は支払い済みです。今回分の支払いは再送していません。再開する前に受取人を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결제 요청서는 이미 결제되었습니다. 이번 회차에는 다시 전송하지 않았습니다. 재개하기 전에 받는 사람에게 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här betalningsbegäran är redan betald. Betalningen för det här tillfället skickades inte igen. Kontrollera mottagaren innan du återupptar."
          }
        }
      }
    },
    "This invoice was already paid: {amount}": {
