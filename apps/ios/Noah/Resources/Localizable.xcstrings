    "This phrase couldn't unlock the backup, or the backup is damaged. Check all 12 or 24 words and their order.": {
      "comment": "GT gt_40db1d4d49d0c277; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phrase couldn't unlock the backup, or the backup is damaged. Check all 12 or 24 words and their order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desbloquear la copia de seguridad con esta frase, o la copia está dañada. Comprueba las 12 o 24 palabras y su orden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフレーズではバックアップのロックを解除できないか、バックアップが破損しています。12個または24個すべての単語とその順序を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문구로 백업의 잠금을 해제할 수 없거나 백업이 손상되었습니다. 12개 또는 24개 단어와 순서를 모두 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att låsa upp säkerhetskopian med den här frasen, eller så är säkerhetskopian skadad. Kontrollera alla 12 eller 24 ord och deras ordning."
          }
        }
      }
    },
