          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envió el depósito. Revísalo de nuevo cuando la billetera esté lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkへの入金は送信されませんでした。ウォレットの準備ができたら再度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입금이 제출되지 않았습니다. 지갑이 준비되면 다시 검토하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Insättningen skickades inte. Granska igen när plånboken är redo."
          }
        }
      }
