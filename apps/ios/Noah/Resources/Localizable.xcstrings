    "The Lightning payment could not be received. Generate a new payment request and try again.": {
      "comment": "GT gt_9dc2f0b60de257af; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lightning payment could not be received. Generate a new payment request and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo recibir el pago Lightning. Genera una nueva solicitud de pago e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightning支払いを受け取れませんでした。新しい支払いリクエストを作成して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightning 결제를 받지 못했습니다. 새 결제 요청을 만들고 다시 시도해 주세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightning-betalningen kunde inte tas emot. Skapa en ny betalningsbegäran och försök igen."
          }
        }
      }
    },
    "The amount Ark receives is below its minimum. Increase the boarding amount.": {
      "comment": "GT gt_f663d0d5c263a46c; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The amount Ark receives is below its minimum. Increase the boarding amount."
