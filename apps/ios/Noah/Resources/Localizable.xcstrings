                  "value": "Dina bitcoin ligger i slutet av en väg med %1$lld transaktion i rundans träd. Rundans egen transaktion finns redan på blockkedjan."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dina bitcoin ligger i slutet av en väg med %1$lld transaktioner i rundans träd. Rundans egen transaktion finns redan på blockkedjan."
                }
              }
            }
          }
        }
      }
    },
    "Your current email stays until the new one is verified.": {
      "comment": "GT gt_8074a7762dd1f578; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current email stays until the new one is verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu correo actual se mantiene hasta que se verifique el nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいメールアドレスが確認されるまでは、現在のアドレスが使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 이메일이 인증될 때까지 현재 이메일이 유지돼요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nuvarande e-post gäller tills den nya är verifierad."
          }
        }
      }
    },
    "Your email is only for urgent alerts about your wallet.": {
      "comment": "GT gt_886bc67a71fe0f83; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email is only for urgent alerts about your wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu correo es solo para alertas urgentes sobre tu billetera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスはウォレットに関する緊急の通知にのみ使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일은 지갑에 관한 긴급 알림에만 사용해요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din e-post används bara för brådskande varningar om din plånbok."
          }
        }
      }
    },
