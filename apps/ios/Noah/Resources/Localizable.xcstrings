    "Disable all wallet operations. The wallet will be closed and won't load until re-enabled.": {
      "comment": "GT gt_22285980b45cde91; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable all wallet operations. The wallet will be closed and won't load until re-enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva todas las operaciones de la billetera. La billetera se cerrará y no se cargará hasta que se vuelva a activar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットのすべての操作を無効にします。ウォレットは閉じられ、再び有効にするまで読み込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 지갑 기능을 비활성화합니다. 지갑이 닫히며, 다시 활성화할 때까지 열리지 않습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaktivera alla plånboksfunktioner. Plånboken stängs och läses inte in förrän den aktiveras igen."
          }
        }
      }
    },
