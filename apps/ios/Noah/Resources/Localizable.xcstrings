      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add about %1$@ on-chain first. Each exit transaction’s fee comes from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade primero unos %1$@ en cadena. La comisión de cada transacción de salida sale de ahí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にオンチェーンに約%1$@を追加してください。出金トランザクションの手数料はそこから支払われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 온체인에 약 %1$@을 추가하세요. 각 출금 트랜잭션의 수수료가 여기서 나가요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg först till ungefär %1$@ på blockkedjan. Avgiften för varje uttagstransaktion tas därifrån."
          }
        }
      }
    },
