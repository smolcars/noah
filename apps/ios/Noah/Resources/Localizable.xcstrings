    "No recurring payments yet. Schedule rent, subscriptions, allowances or donations to an Ark address, Lightning address or BOLT12 offer.": {
      "comment": "GT gt_6a8f8f4a6309d592; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recurring payments yet. Schedule rent, subscriptions, allowances or donations to an Ark address, Lightning address or BOLT12 offer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay pagos recurrentes. Programa pagos de alquiler, suscripciones, asignaciones o donaciones a una dirección de Ark, una dirección de Lightning o una oferta BOLT12."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期支払いはまだありません。Arkアドレス、ライトニングアドレス、BOLT12オファー宛てに、家賃、定期購読料、お小遣い、寄付などの支払いを予約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 정기 결제가 없습니다. Ark 주소, 라이트닝 주소 또는 BOLT12 오퍼로 월세, 구독료, 용돈, 기부금을 정기적으로 보내도록 예약하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga återkommande betalningar ännu. Schemalägg betalningar för hyra, prenumerationer, fickpengar eller donationer till en Ark-adress, en Lightning-adress eller ett BOLT12-erbjudande."
          }
        }
      }
    },
