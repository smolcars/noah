    "A 'satoshi' is its smallest unit.": {
      "comment": "GT bbc81a791db7d63d; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 'satoshi' is its smallest unit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un «satoshi» es su unidad más pequeña."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小単位は「satoshi」です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 작은 단위는 '사토시'입니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ”satoshi” är den minsta enheten i Bitcoin."
          }
        }
      }
    },
    "A balance source is required to send the maximum amount": {
      "comment": "GT a8e941db36f7e854; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A balance source is required to send the maximum amount"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere una fuente de saldo para enviar el importe máximo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全額を送金するには、使用する残高を指定してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 금액을 보내려면 사용할 잔액을 선택해야 합니다"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du måste välja vilket saldo maxbeloppet ska skickas från"
          }
        }
      }
    },
    "A custom Esplora server can observe the Bitcoin addresses and transactions requested by this wallet. Only use a server you trust.": {
      "comment": "GT dc2d69f2130d5f4d; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom Esplora server can observe the Bitcoin addresses and transactions requested by this wallet. Only use a server you trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servidor Esplora personalizado puede ver las direcciones y transacciones de Bitcoin que consulta esta billetera. Usa solo un servidor en el que confíes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムEsploraサーバーは、このウォレットが照会するBitcoinアドレスや取引を確認できます。信頼できるサーバーのみを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 Esplora 서버는 이 지갑이 조회하는 Bitcoin 주소와 거래를 확인할 수 있습니다. 신뢰할 수 있는 서버만 사용하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En anpassad Esplora-server kan se vilka Bitcoin-adresser och transaktioner plånboken begär information om. Använd bara en server som du litar på."
          }
        }
      }
    },
    "A delegated refresh has been scheduled for eligible VTXOs.": {
      "comment": "GT 282b0511470c0007; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A delegated refresh has been scheduled for eligible VTXOs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha programado una renovación delegada para los VTXOs que cumplen los requisitos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象のVTXOの代理更新を予約しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갱신 가능한 VTXO에 대해 위임 갱신이 예약되었습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En delegerad förnyelse har schemalagts för de VTXO:er som uppfyller villkoren."
          }
        }
      }
    },
    "A payment of {nativeValue1} sats for this invoice is already in progress. Do not pay again.": {
