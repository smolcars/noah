          }
        }
      }
    },
    "The operation may have been submitted. Check its status before repeating it. Other recovery operations remain available.": {
      "comment": "GT gt_bc71b743861782dc; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation may have been submitted. Check its status before repeating it. Other recovery operations remain available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que la operación se haya iniciado. Comprueba su estado antes de repetirla. Las demás operaciones de recuperación siguen disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作は受け付けられた可能性があります。再実行する前に状況を確認してください。ほかの復旧操作は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 이미 제출되었을 수 있습니다. 다시 실행하기 전에 상태를 확인하세요. 다른 복구 작업은 계속 사용할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtgärden kan ha skickats in. Kontrollera dess status innan du upprepar den. Andra återställningsåtgärder är fortfarande tillgängliga."
          }
        }
      }
    },
    "The recipient no longer accepts this amount. Update or cancel the recurring payment.": {
      "comment": "GT gt_b0186376f1dac3ea; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipient no longer accepts this amount. Update or cancel the recurring payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destinatario ya no acepta este importe. Actualiza o cancela el pago recurrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受取人は現在、この金額を受け付けていません。定期支払いを変更するか取り消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신자가 더 이상 이 금액을 받지 않습니다. 정기 결제를 수정하거나 취소해 주세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mottagaren accepterar inte längre detta belopp. Uppdatera eller avbryt den återkommande betalningen."
          }
        }
      }
    },
    "The recorded transaction was found. Review its network status.": {
      "comment": "GT gt_0d09cc372ee7f6aa; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recorded transaction was found. Review its network status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró la transacción registrada. Revisa su estado en la red."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された取引が見つかりました。ネットワーク上の状況を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 거래를 찾았습니다. 해당 거래의 네트워크 상태를 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den registrerade transaktionen hittades. Granska dess nätverksstatus."
          }
        }
      }
    },
    "The selected balance cannot cover this payment and its fee.": {
      "comment": "GT gt_a8e2a0913b846c88; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected balance cannot cover this payment and its fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo seleccionado no alcanza para cubrir este pago y su comisión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した残高では、支払い額と手数料を賄えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 잔액으로는 결제 금액과 수수료를 충당할 수 없습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det valda saldot räcker inte till betalningen och avgiften."
          }
        }
      }
    },
    "The selected items have reached a state that resolves this attempt. Review their current status and history before continuing.": {
      "comment": "GT gt_16bade73921c8987; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected items have reached a state that resolves this attempt. Review their current status and history before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado de los elementos seleccionados permite dar por resuelto este intento. Revisa su estado actual y su historial antes de continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目の状態から、この試行の結果が確定しました。続行する前に現在の状況と履歴を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목의 상태가 변경되어 이 시도가 종결되었습니다. 계속하기 전에 현재 상태와 내역을 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De valda objektens tillstånd har klargjort utfallet av det här försöket. Granska deras aktuella status och historik innan du fortsätter."
          }
        }
      }
    },
    "The server isn't responding; switching back…": {
      "comment": "GT gt_b1b5c1f750db3d4a; arguments: none",
