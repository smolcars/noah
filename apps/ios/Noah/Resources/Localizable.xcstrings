    "Check the amount, selected VTXOs, and destination. There may not be enough confirmed funds.": {
      "comment": "GT gt_c31be569a492274b; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the amount, selected VTXOs, and destination. There may not be enough confirmed funds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el importe, los VTXO seleccionados y el destino. Puede que no haya suficientes fondos confirmados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額、選択したVTXO、送信先を確認してください。確認済みの資金が不足している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액, 선택한 VTXO, 목적지를 확인하세요. 확정된 자금이 부족할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera beloppet, valda VTXO:er och destinationen. Det kanske inte finns tillräckligt med bekräftade medel."
          }
        }
      }
    },
