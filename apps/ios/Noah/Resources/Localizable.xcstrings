    "Submission stopped before a transaction could be recorded. Review the amount and fee before trying again.": {
      "comment": "GT gt_1af1dbb07ecbb25a; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submission stopped before a transaction could be recorded. Review the amount and fee before trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío se detuvo antes de que se pudiera registrar una transacción. Revisa el importe y la comisión antes de intentarlo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引が記録される前に送信が停止しました。再試行する前に金額と手数料を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 기록되기 전에 제출이 중단되었습니다. 다시 시도하기 전에 금액과 수수료를 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sändningen stoppades innan en transaktion kunde registreras. Granska beloppet och avgiften innan du försöker igen."
          }
        }
      }
    },
