    "The Esplora endpoint cannot include a query string or fragment.": {
      "comment": "GT gt_19fe068bbdba00e6; arguments: none",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Esplora endpoint cannot include a query string or fragment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El punto de acceso de Esplora no puede incluir una cadena de consulta ni un fragmento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Esploraエンドポイントにクエリ文字列やフラグメントは含められません。"
