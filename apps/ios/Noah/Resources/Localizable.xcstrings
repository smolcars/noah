            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "この出金は現在のブロック高より遅れています。最終確認はブロック %2$@（%1$lldブロック前）です。出金を進めると、出金トランザクションが送信されることもあります。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "この出金は現在のブロック高より遅れています。最終確認はブロック %2$@（%1$lldブロック前）です。出金を進めると、出金トランザクションが送信されることもあります。"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "이 출금은 현재 블록 높이보다 뒤처져 있습니다. 마지막 확인은 블록 %2$@(%1$lld블록 전)입니다. 출금을 진행하면 출금 거래를 보낼 수도 있습니다."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "이 출금은 현재 블록 높이보다 뒤처져 있습니다. 마지막 확인은 블록 %2$@(%1$lld블록 전)입니다. 출금을 진행하면 출금 거래를 보낼 수도 있습니다."
                }
              }
            }
          }
        },
        "sv": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Det här nöduttaget ligger efter kedjans aktuella höjd: senast kontrollerat i block %2$@, för %1$lld block sedan. Att flytta fram det kan också skicka nöduttagstransaktioner."
                }
              },
