<?xml version="1.0" encoding="utf-8"?>
<!-- The 4×1 widget (widgets.md, Android): the longship, the balance and one line, then Receive, Scan and Send. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:layoutDirection="ltr"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="14dp">

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="26dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ship"
            android:tint="@color/widget_text" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mark_wave"
            android:tint="@color/widget_wave" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_balance"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/space_grotesk_semibold"
            android:fontFeatureSettings="tnum"
            android:gravity="bottom|start"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="24sp" />

        <LinearLayout
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_status_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_home_renew"
                android:tint="@color/widget_text"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/widget_dot"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_status_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_fiat"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_chip"
        android:fontFamily="sans-serif-medium"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="3dp"
        android:textColor="@color/widget_chip_text"
        android:textSize="11sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/widget_receive"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_circle">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tab_receive"
            android:tint="@color/widget_text" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_scan"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_circle">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_home_scan"
            android:tint="@color/widget_text" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_send"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_circle">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tab_send"
            android:tint="@color/widget_text" />
    </FrameLayout>
</LinearLayout>
