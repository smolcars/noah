<?xml version="1.0" encoding="utf-8"?>
<!--
    The 2×2 widget (widgets.md, Android): label row, the wave, balance, fiat and one status line. Also the provider's
    initial layout, whose name the upgrade check pins. Rows grow with large text; WidgetViews measures them to place the
    wave and boat, or to choose the 2×1 where they don't fit.
    Tints are android:tint in every widget layout: launchers inflate framework views, which ignore AppCompat's app:tint.
-->
<!-- Attributes newer than minSdk (clipToOutline, autoSize, textFontWeight) only refine newer launchers; widget text can't be selected. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:layoutDirection="ltr"
    tools:ignore="UseAppTint,UnusedAttribute,SelectableText">

    <FrameLayout
        android:id="@+id/widget_sea_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_sea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_boat_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_boat"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ship"
            android:tint="@color/widget_text"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="15dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="600"
                    android:textStyle="bold"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_change_days"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="NestedWeights"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_chip"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:textColor="@color/widget_chip_text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- A weighted spacer: RemoteViews has no Space. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            tools:ignore="UselessLeaf"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_balance"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:tint="@color/widget_text" />

        <TextView
            android:id="@+id/widget_fiat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="17dp"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="17dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_status_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_home_renew"
                    android:tint="@color/widget_text"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_status_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/widget_dot"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:hyphenationFrequency="none"
                    android:gravity="center_vertical|start"
                    android:includeFontPadding="false"
                    android:breakStrategy="simple"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/widget_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:hyphenationFrequency="none"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:breakStrategy="simple"
                android:ellipsize="end"
                android:maxLines="2"
                android:minHeight="17dp"
                android:textColor="@color/widget_muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
