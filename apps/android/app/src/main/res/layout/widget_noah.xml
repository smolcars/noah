<?xml version="1.0" encoding="utf-8"?>
<!-- The provider sets every text; values here are only the picker preview's. The 2x1 widget's small type is deliberate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_background"
    tools:ignore="SmallSp">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wallet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/widgetTextSecondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/variant_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_badge"
            android:textColor="@color/widgetBadgeText"
            android:textSize="8sp"
            android:textStyle="bold"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/badge_background"
            android:visibility="visible" />

    </LinearLayout>

    <!-- Main balance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/balance_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_balance"
            android:textColor="@color/widgetTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pending_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Pending: 0 sats"
            android:textColor="@color/widgetPendingText"
            android:textSize="8sp"
            android:visibility="gone" />

        <!-- Expiry status: RemoteViews tints the icon, which a compound drawable can't take -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="UseCompoundDrawables"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <!-- Shown only with an expiry, so the picker preview has no untranslated count -->
            <ImageView
                android:id="@+id/expiry_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@android:drawable/checkbox_on_background"
                android:importantForAccessibility="no"
                android:layout_marginEnd="3dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/expiry_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0 blocks"
                android:textSize="8sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Onchain/Offchain breakdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/onchain_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:text="@string/widget_onchain"
                android:textColor="@color/widgetTextSecondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/onchain_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_amount"
                android:textColor="@color/widgetTextPrimary"
                android:textSize="9sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="1dp">

            <TextView
                android:id="@+id/offchain_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:text="@string/widget_offchain"
                android:textColor="@color/widgetTextSecondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/offchain_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_amount"
                android:textColor="@color/widgetTextPrimary"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
