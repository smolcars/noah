<?xml version="1.0" encoding="utf-8"?>
<!-- The 2×1 widget (widgets.md, Android): the longship, the balance and one line (status, or fiat). -->
<!-- Attributes newer than minSdk (clipToOutline, autoSize, textFontWeight) only refine newer launchers; widget text can't be selected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:layoutDirection="ltr"
    tools:ignore="UseAppTint,UnusedAttribute,SelectableText"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="19dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ship"
            android:tint="@color/widget_text" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mark_wave"
            android:tint="@color/widget_wave" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_balance"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:tint="@color/widget_text" />

        <LinearLayout
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:minHeight="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:hyphenationFrequency="none"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:breakStrategy="simple"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_fiat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="16dp"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
