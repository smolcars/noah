<?xml version="1.0" encoding="utf-8"?>
<!-- The 2×1 widget (widgets.md, Android): the longship, the balance and one line (status, or fiat). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:layoutDirection="ltr"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="19dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ship"
            android:tint="@color/widget_text" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mark_wave"
            android:tint="@color/widget_wave" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_balance"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/space_grotesk_semibold"
            android:fontFeatureSettings="tnum"
            android:gravity="bottom|start"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="24sp" />

        <LinearLayout
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_status_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_fiat"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
