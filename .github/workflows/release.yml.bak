name: Release

on:
  push:
    tags:
      - "v*"

jobs:
  android-signet-build:
    name: Build Android Signet Artifacts
    uses: ./.github/workflows/android-artifacts.yml
    with:
      variant: signet
      git_ref: ${{ github.ref }}
    secrets: inherit

  android-mainnet-build:
    name: Build Android Mainnet Artifacts
    uses: ./.github/workflows/android-artifacts.yml
    with:
      variant: mainnet
      git_ref: ${{ github.ref }}
    secrets: inherit

  ios-archive:
    name: Build iOS ${{ matrix.display_name }} Archive
    runs-on: macOS
    strategy:
      fail-fast: false
      matrix:
        include:
          - variant: mainnet
            display_name: Mainnet
            build_script: build:ios:mainnet:archive
            archive_name: Noah-mainnet.xcarchive
            artifact_filename: noah-mainnet.xcarchive.tar.gz
          - variant: signet
            display_name: Signet
            build_script: build:ios:signet:archive
            archive_name: Noah-signet.xcarchive
            artifact_filename: noah-signet.xcarchive.tar.gz
    env:
      # Self-hosted runners persist /nix/store; avoid stale Magic Nix Cache hooks/proxies.
      NIX_CONFIG: |
        post-build-hook =
        extra-substituters =
        substituters = https://cache.nixos.org/
    steps:
      - name: 🏗 Checkout repository
        uses: actions/checkout@v6

      - name: 📦 Install dependencies
        run: nix develop .# --command bash -c "bun install --frozen-lockfile"

      - name: 🔧 Create sentry.properties
        env:
          SENTRY_AUTH_TOKEN: ${{ secrets.SENTRY_AUTH_TOKEN }}
        run: ./scripts/create_sentry_properties.sh

      - name: 🛠️ Build development-signed archive
        run: nix develop .# --command bash -c "bun client ios:prebuild && bun client ${{ matrix.build_script }}"

      - name: 📦 Package archive
        run: |
          tar -czf "client/ios/build/${{ matrix.artifact_filename }}" \
            -C client/ios/build "${{ matrix.archive_name }}"

      - name: 📤 Upload archive artifact
        uses: actions/upload-artifact@v7
        with:
          path: client/ios/build/${{ matrix.artifact_filename }}
          archive: false
          if-no-files-found: error
          retention-days: 90

      - name: 🧹 Clean up build artifacts
        if: always()
        run: |
          rm -rf client/ios/build
          rm -f client/android/sentry.properties
          rm -f client/ios/sentry.properties

  release:
    name: Create GitHub Release
    runs-on: ubuntu-latest
    needs: [android-signet-build, android-mainnet-build, ios-archive]
    permissions:
      contents: write
    steps:
      - name: 📥 Download signet APK artifact
        uses: actions/download-artifact@v8
        with:
          name: ${{ needs.android-signet-build.outputs.apk_artifact_name }}
          path: release-assets/signet

      - name: 📥 Download mainnet APK artifact
        uses: actions/download-artifact@v8
        with:
          name: ${{ needs.android-mainnet-build.outputs.apk_artifact_name }}
          path: release-assets/mainnet-apk

      - name: 📝 Prepare release assets
        run: |
          set -euo pipefail
          mv "release-assets/signet/${{ needs.android-signet-build.outputs.apk_filename }}" \
            release-assets/noah-signet.apk
          mv "release-assets/mainnet-apk/${{ needs.android-mainnet-build.outputs.apk_filename }}" \
            release-assets/noah-mainnet.apk

      - name: 🚀 Create GitHub Release
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          release_version="${GITHUB_REF_NAME%.signet}"

          gh release create "${GITHUB_REF_NAME}" \
            release-assets/noah-signet.apk \
            release-assets/noah-mainnet.apk \
            --repo "${{ github.repository }}" \
            --title "Noah ${release_version}" \
            --generate-notes
